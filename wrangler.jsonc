{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mashbean-blog",
  "compatibility_date": "2026-01-01",
  // Pure static Astro output served from dist/ — no Worker script needed.
  // The Cloudflare "Workers Build" runs `npm run build` then `npx wrangler deploy`,
  // which uploads ./dist as static assets.
  "assets": {
    "directory": "./dist",
    // Astro uses trailingSlash: "always" + build.format: "directory", so pages
    // live at /path/index.html — auto-trailing-slash resolves /path -> /path/.
    "html_handling": "auto-trailing-slash",
    // Serve the Astro-generated 404 page for unmatched routes.
    "not_found_handling": "404-page"
  }
}
