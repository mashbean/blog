---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getBlogPosts } from "@/utils/blog";
import { withBase } from "@/utils/paths";

const posts = await getBlogPosts();
const latestPosts = posts.slice(0, 10);
---

<BaseLayout title="首頁" description="最新文章與內容更新。">
  <section class="hero">
    <p class="hero-kicker">Mashbean Blog</p>
    <h1 class="hero-title">內容優先的 Astro 部落格</h1>
    <p class="hero-text">
      先穩定遷移，再逐步加互動。這版 MVP 專注在內容模型、SEO、RSS、部署一致性。
    </p>
  </section>

  <h2 class="section-title">最新文章</h2>
  {
    latestPosts.length === 0 ? (
      <p class="empty-state">目前還沒有文章。</p>
    ) : (
      <ul class="post-list">
        {latestPosts.map((post) => <li><PostCard post={post} /></li>)}
      </ul>
    )
  }

  <p style="margin-top: 1rem;">
    <a href={withBase("blog/")}>查看全部文章 -></a>
  </p>
</BaseLayout>
