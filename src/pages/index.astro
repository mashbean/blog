---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getBlogPosts } from "@/utils/blog";
import { withBase } from "@/utils/paths";

const posts = await getBlogPosts();
const latestPosts = posts.slice(0, 12);
const featuredPost = latestPosts[0];
const recentPosts = latestPosts.slice(1);
---

<BaseLayout title="首頁" description="最新文章與內容更新。">
  <section class="hero">
    <figure style="margin:0;">
      <blockquote class="hero-text" style="margin:0;">
        <p style="margin:0 0 .5rem;">能身處黎明時分，簡直是天賜之福；</p>
        <p style="margin:0;">若還年輕，更如置身天堂！</p>
      </blockquote>
      <figcaption class="hero-kicker" style="margin-top:.75rem;">華茲華斯（Wordsworth）</figcaption>
    </figure>
  </section>

  <div class="home-section-head">
    <h2 class="section-title">最新文章</h2>
    <p class="home-section-meta">最近更新 {latestPosts.length} 篇</p>
  </div>
  {
    latestPosts.length === 0 ? (
      <p class="empty-state">目前還沒有文章。</p>
    ) : (
      <>
        {featuredPost && (
          <section aria-label="精選最新文章">
            <PostCard post={featuredPost} variant="feature" />
          </section>
        )}
        {recentPosts.length > 0 && (
          <section class="home-post-grid" aria-label="近期更新">
            <ul class="post-list post-list-compact-grid">
              {recentPosts.map((post) => <li><PostCard post={post} variant="compact" /></li>)}
            </ul>
          </section>
        )}
      </>
    )
  }

  <p class="home-all-link">
    <a href={withBase("blog/")}>查看全部文章 -></a>
  </p>
</BaseLayout>
