---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeFeedItem from "@/components/HomeFeedItem.astro";
import type { HomeFeedItem as FeedItem } from "@/data/homeFeed";
import { getDecks } from "@/data/decks";
import { works } from "@/data/works";
import { buildPostUrl, getBlogPosts } from "@/utils/blog";
import { resolveCoverPath } from "@/utils/cover";
import { withBase } from "@/utils/paths";
import { getProFeedEntries } from "@/utils/proFeed";
import { cleanPostTitle } from "@/utils/title";

const posts = await getBlogPosts();
const now = new Date();
const today = now.toISOString().slice(0, 10);

const resolveImage = (cover?: string): string | undefined => {
  const resolved = resolveCoverPath(cover);
  if (!resolved) return undefined;
  return /^https?:\/\//.test(resolved.primary) ? resolved.primary : withBase(resolved.primary);
};

const postItems: FeedItem[] = posts.slice(0, 12).map((post) => ({
  id: `article-${post.id}`,
  kind: "article",
  label: "文章",
  title: cleanPostTitle(post.data.title),
  summary: post.data.description,
  date: post.data.pubDate,
  url: buildPostUrl(post),
  detail: post.data.category,
  image: resolveImage(post.data.cover),
  imageAlt: post.data.coverAlt ?? cleanPostTitle(post.data.title),
}));

const deckItems: FeedItem[] = getDecks()
  .filter((deck) => deck.date <= today)
  .slice(0, 8)
  .map((deck) => ({
    id: `deck-${deck.slug}`,
    kind: "deck",
    label: "簡報",
    title: deck.title,
    summary: [deck.event, deck.location].filter(Boolean).join(" · "),
    date: new Date(`${deck.date}T12:00:00+08:00`),
    url: withBase(deck.url.replace(/^\//, "")),
    detail: deck.lang === "en" ? "English" : undefined,
  }));

const workItems: FeedItem[] = works
  .slice()
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 8)
  .map((work) => ({
    id: `work-${work.slug}`,
    kind: "work",
    label: "專題",
    title: work.title,
    summary: work.tagline,
    date: new Date(`${work.date}T12:00:00+08:00`),
    url: work.url,
    detail: work.chips?.slice(0, 2).join(" · "),
    image: work.cover ? withBase(work.cover) : undefined,
    imageAlt: work.title,
    external: true,
  }));

const proItems: FeedItem[] = (await getProFeedEntries())
  .filter((entry) => entry.date <= now)
  .slice(0, 8)
  .map((entry) => ({
    id: `pro-${entry.url}`,
    kind: "pro",
    label: "難題",
    title: entry.title,
    summary: entry.description,
    date: entry.date,
    url: entry.url,
    detail: "pro.mashbean.net",
    image: entry.image,
    imageAlt: entry.title,
    external: true,
  }));

const feedItems = [...postItems, ...deckItems, ...workItems, ...proItems]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 24);
---

<BaseLayout description="站在單向鏡後方觀看世界應對加速科技的方式。">
  <section class="home-intro" aria-labelledby="home-intro-title">
    <div class="home-intro-copy">
      <p class="home-intro-kicker">mashbean.net</p>
      <h1 id="home-intro-title">寫作、研究與手作，沿著時間收在一起。</h1>
      <p>文章、簡報、專題與「難題」研究報告，共用一條更新時間軸。</p>
    </div>
    <figure class="home-quote">
      <blockquote>
        <p>能身處黎明時分，簡直是天賜之福；若還年輕，更如置身天堂！</p>
      </blockquote>
      <figcaption>華茲華斯（Wordsworth）</figcaption>
    </figure>
  </section>

  <aside
    id="continue-reading-toast"
    class="continue-reading-toast"
    hidden
    aria-label="繼續閱讀通知"
  >
    <button
      id="continue-reading-close"
      class="continue-reading-close"
      type="button"
      aria-label="關閉繼續閱讀通知"
    >
      關閉
    </button>
    <a id="continue-reading-link" class="continue-reading-link" href="/blog/">
      <strong id="continue-reading-title">繼續閱讀</strong>
      <span id="continue-reading-meta">進度 0%</span>
    </a>
  </aside>

  <div class="home-section-head">
    <div>
      <p class="home-section-kicker">Timeline</p>
      <h2 class="section-title">最近更新</h2>
    </div>
    <p class="home-section-meta">四個來源 · {feedItems.length} 則</p>
  </div>
  {
    feedItems.length === 0 ? (
      <p class="empty-state">目前還沒有更新。</p>
    ) : (
      <section class="home-feed-wrap" aria-label="近期更新時間軸">
        <ol class="home-feed-list">
          {feedItems.map((item) => (
            <li>
              <HomeFeedItem item={item} />
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <nav class="home-source-links" aria-label="瀏覽所有內容">
    <a href={withBase("blog/")}>所有文章</a>
    <a href={withBase("decks/")}>所有簡報</a>
    <a href={withBase("works/")}>所有專題</a>
    <a href="https://pro.mashbean.net/" target="_blank" rel="noopener noreferrer">前往難題 ↗</a>
  </nav>
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
    gap: 1rem;
    align-items: stretch;
    margin-bottom: 1.35rem;
  }

  .home-intro-copy,
  .home-quote {
    border: 1px solid var(--color-border-subtle);
    border-radius: 1.15rem;
  }

  .home-intro-copy {
    padding: clamp(1.2rem, 3vw, 2rem);
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 228, 168, 0.46), transparent 42%),
      linear-gradient(135deg, #f1fbf7 0%, #ffffff 72%);
  }

  .home-intro-kicker,
  .home-section-kicker {
    margin: 0;
    color: var(--color-accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-intro h1 {
    max-width: 17em;
    margin: 0.38rem 0 0;
    font-size: clamp(1.7rem, 3.4vw, 2.65rem);
    line-height: 1.2;
  }

  .home-intro-copy > p:last-child {
    max-width: 35rem;
    margin: 0.72rem 0 0;
    color: var(--color-muted);
  }

  .home-quote {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding: 1.2rem 1.25rem;
    background: rgba(255, 255, 255, 0.68);
  }

  .home-quote blockquote,
  .home-quote p {
    margin: 0;
  }

  .home-quote p {
    color: #344f5a;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.75;
  }

  .home-quote figcaption {
    margin-top: 0.65rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .home-section-head {
    margin-top: 1.45rem;
  }

  .home-section-head .section-title {
    margin: 0.12rem 0 0;
  }

  .home-feed-wrap {
    margin-top: 1rem;
  }

  .home-feed-list {
    position: relative;
    display: grid;
    gap: 0.78rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-feed-list::before {
    content: "";
    position: absolute;
    top: 1.45rem;
    bottom: 1.45rem;
    left: 7.75rem;
    width: 1px;
    background: linear-gradient(180deg, #bad8d0 0%, #d8e3df 88%, transparent 100%);
  }

  .home-feed-list > li {
    min-width: 0;
  }

  .home-source-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.25rem 0 0;
    padding-left: 9.1rem;
  }

  .home-source-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    padding: 0.28rem 0.78rem;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.72);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .home-source-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .home-intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-quote {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .home-feed-list {
      gap: 1rem;
    }

    .home-feed-list::before {
      top: 0.42rem;
      bottom: 1rem;
      left: 0.45rem;
    }

    .home-source-links {
      padding-left: 1.72rem;
    }
  }
</style>

<script is:inline>
  const section = document.querySelector("#continue-reading-toast");
  const closeButton = document.querySelector("#continue-reading-close");
  const link = document.querySelector("#continue-reading-link");
  const title = document.querySelector("#continue-reading-title");
  const meta = document.querySelector("#continue-reading-meta");
  const key = "mashbean.blog.lastReading";
  const dismissPrefix = "mashbean.blog.lastReading.dismissed.";

  try {
    const raw = localStorage.getItem(key);
    if (!raw) throw new Error("empty");
    const data = JSON.parse(raw);
    if (!data || typeof data.url !== "string" || typeof data.title !== "string") {
      throw new Error("invalid");
    }

    if (link instanceof HTMLAnchorElement) {
      link.href = data.url;
    }
    if (title instanceof HTMLElement) {
      title.textContent = `繼續閱讀｜${data.title}`;
    }
    if (meta instanceof HTMLElement) {
      const progress =
        typeof data.progress === "number" ? Math.max(0, Math.min(100, data.progress)) : 0;
      meta.textContent = `進度 ${progress}%`;
    }
    const dismissKey = `${dismissPrefix}${data.url}::${data.title}`;
    const dismissed = localStorage.getItem(dismissKey) === "1";
    if (section instanceof HTMLElement && !dismissed) {
      section.hidden = false;
      section.dataset.dismissKey = dismissKey;
    }
  } catch {
    if (section instanceof HTMLElement) section.hidden = true;
  }

  closeButton?.addEventListener("click", () => {
    if (!(section instanceof HTMLElement)) return;
    section.hidden = true;
    const dismissKey = section.dataset.dismissKey;
    if (dismissKey) {
      localStorage.setItem(dismissKey, "1");
    }
  });
</script>
