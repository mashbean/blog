---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/paths";
import { buildAlternatesFor } from "@/utils/alternates";

const target = withBase("tags/?source=facebook");
// 純轉址頁，沒有英文對應版，因此只宣告 zh，不產生指向不存在 /en 頁的 hreflang。
const alternates = buildAlternatesFor("facebook/", "zh-TW", ["zh-TW"]);
---

<BaseLayout title="臉書文" description="臉書文已整合到標籤與搜尋。" alternates={alternates}>
  <section class="subscribe-panel">
    <h1 class="section-title" style="margin-top: 0;">臉書文入口已整合</h1>
    <p>臉書文已整合到標籤與搜尋。</p>
    <p>
      立即前往：<a href={target}>{target}</a>
    </p>
  </section>
</BaseLayout>

<script is:inline define:vars={{ target }}>
  if (window.location.pathname.endsWith('/facebook/') || window.location.pathname.endsWith('/facebook')) {
    window.location.replace(target);
  }
</script>
