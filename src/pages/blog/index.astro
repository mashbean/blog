---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPostUrl, getBlogPosts } from "@/utils/blog";
import { formatDate } from "@/utils/date";
import { classifyPostTags, getTopicCatalog } from "@/utils/blogTags";
import { cleanPostTitle } from "@/utils/title";

const posts = await getBlogPosts();
const topicCatalog = getTopicCatalog();
const yearMap = new Map<number, typeof posts>();

for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  const bucket = yearMap.get(year);
  if (bucket) {
    bucket.push(post);
  } else {
    yearMap.set(year, [post]);
  }
}

const yearSections = Array.from(yearMap.entries())
  .map(([year, yearPosts]) => ({
    year,
    posts: yearPosts,
    count: yearPosts.length
  }))
  .sort((a, b) => b.year - a.year);

const yearNotes: Record<number, string> = {
  2026: "試圖融合密碼龐克、曲線救國、以及政策設計等不同路線",
  2025: "離開數位發展部，參與各種 Fellow 計畫，如哈佛甘迺迪學院、以太坊基金會、TWNIC...等等，加入 Matters",
  2024: "在數位發展部推動數位皮夾，研究各國數位身分政策",
  2023: "加入數位發展部多元宇宙科，研究 web3 政策與國際標準組織（W3C），開始典藏Artouch 薄荷薄荷專欄",
  2022: "創辦了 FAB DAO（#非營利 web3 行動），參與 Volume DAO（#數位藝術），參展林茲電子藝術節",
  2021: "自醫師工作離職，開始探索 web3 與 NFT，畫了新時代國旗"
};

const RECENT_UPDATED_DAYS = 90;
const recentThreshold = Date.now() - RECENT_UPDATED_DAYS * 24 * 60 * 60 * 1000;
const isRecentlyUpdated = (updatedDate?: Date) =>
  Boolean(updatedDate && updatedDate.getTime() >= recentThreshold);

const topicByPostId = new Map<string, string[]>();
for (const post of posts) {
  const classified = classifyPostTags({
    title: cleanPostTitle(post.data.title),
    description: post.data.description,
    body: post.body,
    tags: post.data.tags
  });
  topicByPostId.set(post.id, classified.topics);
}

const topicFilterOptions = topicCatalog
  .map((item) => ({
    key: item.key,
    icon: item.icon,
    title: item.title,
    count: posts.filter((post) => (topicByPostId.get(post.id) ?? []).includes(item.key)).length
  }))
  .filter((item) => item.count > 0);
---

<BaseLayout title="文章列表" description="依日期由新到舊的所有文章。">
  <h1 class="section-title">文章列表</h1>
  <p>共 {posts.length} 篇，依日期由新到舊。</p>

  {
    posts.length === 0 ? (
      <p class="empty-state">目前還沒有文章。</p>
    ) : (
      <>
        <div class="archive-quick-filter" role="group" aria-label="文章主題篩選">
          <button type="button" class="archive-filter-btn is-active" data-topic="all">
            全部
          </button>
          {
            topicFilterOptions.map((item) => (
              <button type="button" class="archive-filter-btn" data-topic={item.key}>
                {item.icon} {item.title}
              </button>
            ))
          }
        </div>
        <p id="archive-filter-status" class="archive-filter-status" aria-live="polite">
          目前顯示全部主題
        </p>
        <div class="archive-accordion-list" aria-label="年份文章收合列表">
          {
            yearSections.map((section, index) => (
              <details class="archive-accordion" open={index === 0} data-filterable-accordion>
                <summary class="archive-accordion-summary">
                  <span class="archive-accordion-title">
                    <span class="tag-chip-icon" aria-hidden="true">🗓️</span>
                    {section.year} 年
                  </span>
                  {yearNotes[section.year] && (
                    <span class="archive-accordion-note">{yearNotes[section.year]}</span>
                  )}
                  <span class="archive-accordion-count" data-count data-total={section.count}>{section.count} 篇</span>
                </summary>
                <div class="archive-accordion-body">
                  <div class="archive-accordion-body-inner">
                    <ul class="archive-list">
                      {
                        section.posts.map((post) => {
                          const topics = topicByPostId.get(post.id) ?? ["公共網路"];
                          return (
                          <li class="archive-item" data-topics={topics.join("|")}>
                            <time class="archive-date" datetime={post.data.pubDate.toISOString()}>
                              {formatDate(post.data.pubDate)}
                            </time>
                          <div class="archive-main">
                            <a class="archive-link" href={buildPostUrl(post)}>{cleanPostTitle(post.data.title)}</a>
                            <p class="archive-meta">
                              主題：{topics.join("・")}
                              {isRecentlyUpdated(post.data.updatedDate) && (
                                <span class="archive-update-badge" title={`近 ${RECENT_UPDATED_DAYS} 天內更新`}>
                                  最近更新
                                </span>
                              )}
                            </p>
                          </div>
                          </li>
                        )})
                      }
                    </ul>
                  </div>
                </div>
              </details>
            ))
          }
          <details class="archive-accordion">
            <summary class="archive-accordion-summary">
              <span class="archive-accordion-title">
                <span class="tag-chip-icon" aria-hidden="true">🗓️</span>
                2020 年
              </span>
              <span class="archive-accordion-note">2020 年以前我在醫院見習、實習、一般住院醫師訓練，文章大多放在 Medium，可以點過去閱讀</span>
            </summary>
            <div class="archive-accordion-body">
              <div class="archive-accordion-body-inner">
                <p class="archive-meta" style="margin: 0;">
                  <a href="https://medium.com/@mashbean" target="_blank" rel="noopener noreferrer">
                    前往 Medium 閱讀（@mashbean） →
                  </a>
                </p>
              </div>
            </div>
          </details>
        </div>
      </>
    )
  }
</BaseLayout>

<script is:inline>
  const filterButtons = Array.from(document.querySelectorAll(".archive-filter-btn"));
  const filterableAccordions = Array.from(
    document.querySelectorAll("details[data-filterable-accordion]")
  );
  const status = document.querySelector("#archive-filter-status");
  let activeTopic = "all";

  const updateStatus = (topic) => {
    if (!(status instanceof HTMLElement)) return;
    const button = filterButtons.find((item) => item.dataset.topic === topic);
    const text = button?.textContent?.trim() ?? "全部";
    status.textContent = topic === "all" ? "目前顯示全部主題" : `目前顯示：${text}`;
  };

  const applyFilter = (topic) => {
    activeTopic = topic;
    filterButtons.forEach((button) => {
      button.classList.toggle("is-active", button.dataset.topic === topic);
    });

    for (const accordion of filterableAccordions) {
      const items = Array.from(accordion.querySelectorAll(".archive-item[data-topics]"));
      let visibleCount = 0;
      for (const item of items) {
        const topics = (item.getAttribute("data-topics") ?? "").split("|").filter(Boolean);
        const visible = topic === "all" || topics.includes(topic);
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      const count = accordion.querySelector("[data-count]");
      if (count instanceof HTMLElement) {
        count.textContent = `${visibleCount} 篇`;
      }
      accordion.hidden = visibleCount === 0;
    }
    updateStatus(topic);
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      applyFilter(button.dataset.topic ?? "all");
    });
  });

  applyFilter(activeTopic);
</script>
