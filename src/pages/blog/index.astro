---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPostUrl, getBlogPosts } from "@/utils/blog";
import { buildFacebookPostUrl, getFacebookPosts } from "@/utils/facebook";
import { formatDate } from "@/utils/date";
import { classifyPostTags } from "@/utils/blogTags";
import { cleanPostTitle } from "@/utils/title";

const posts = await getBlogPosts();
const featuredFacebookPosts = await getFacebookPosts({ featuredOnly: true });
type ArchiveEntry = {
  id: string;
  url: string;
  title: string;
  pubDate: Date;
  updatedDate?: Date;
  topics: string[];
};

const entries: ArchiveEntry[] = [
  ...posts.map((post) => {
    const classified = classifyPostTags({
      title: cleanPostTitle(post.data.title),
      description: post.data.description,
      body: post.body,
      tags: post.data.tags,
    });
    return {
      id: `post:${post.id}`,
      url: buildPostUrl(post),
      title: cleanPostTitle(post.data.title),
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      topics: classified.topics,
    };
  }),
  ...featuredFacebookPosts.map((post) => {
    const classified = classifyPostTags({
      title: cleanPostTitle(post.data.title),
      description: post.data.description,
      body: post.body,
      tags: post.data.tags,
    });
    return {
      id: `facebook:${post.id}`,
      url: buildFacebookPostUrl(post),
      title: cleanPostTitle(post.data.title),
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      topics: classified.topics,
    };
  }),
].sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const toYearBucket = (date: Date) => {
  const year = date.getFullYear();
  if (year <= 2020) return "pre2020";
  return String(year);
};

const toYearLabel = (bucket: string) => (bucket === "pre2020" ? "2020 年以前" : `${bucket} 年`);

const yearMap = new Map<string, ArchiveEntry[]>();
for (const entry of entries) {
  const key = toYearBucket(entry.pubDate);
  const bucket = yearMap.get(key);
  if (bucket) bucket.push(entry);
  else yearMap.set(key, [entry]);
}

const yearSections = Array.from(yearMap.entries())
  .map(([yearBucket, yearPosts]) => ({
    yearBucket,
    yearLabel: toYearLabel(yearBucket),
    sortYear: yearBucket === "pre2020" ? 2020 : Number(yearBucket),
    posts: yearPosts,
    count: yearPosts.length,
  }))
  .sort((a, b) => b.sortYear - a.sortYear);

const yearNotes: Record<string, string> = {
  2026: "試圖融合密碼龐克、曲線救國、以及政策設計等不同路線",
  2025: "離開數位發展部，參與各種 Fellow 計畫，如哈佛甘迺迪學院、以太坊基金會、TWNIC...等等，加入 Matters",
  2024: "在數位發展部推動數位皮夾，研究各國數位身分政策",
  2023: "加入數位發展部多元宇宙科，研究 web3 政策與國際標準組織（W3C），開始典藏Artouch 薄荷薄荷專欄",
  2022: "創辦了 FAB DAO（#非營利 web3 行動），參與 Volume DAO（#數位藝術），參展林茲電子藝術節",
  2021: "自醫師工作離職，開始探索 web3 與 NFT，畫了新時代國旗",
  pre2020: "2020 年以前文章已統一收斂於此，包含早期探索、見習與臨床階段的紀錄",
};

const RECENT_UPDATED_DAYS = 90;
const recentThreshold = Date.now() - RECENT_UPDATED_DAYS * 24 * 60 * 60 * 1000;
const isRecentlyUpdated = (pubDate: Date, updatedDate?: Date) => {
  const reference = updatedDate ?? pubDate;
  return reference.getTime() >= recentThreshold;
};

---

<BaseLayout title="精選文章" description="依日期由新到舊的精選文章。">
  <h1 class="section-title">精選文章</h1>

  {
    entries.length === 0 ? (
      <p class="empty-state">目前還沒有文章。</p>
    ) : (
      <>
        <div class="archive-accordion-list" aria-label="年份文章收合列表">
          {yearSections.map((section, index) => (
            <details class="archive-accordion" open={index === 0}>
              <summary class="archive-accordion-summary">
                <span class="archive-accordion-title">
                  <span class="tag-chip-icon" aria-hidden="true">
                    🗓️
                  </span>
                  {section.yearLabel}
                </span>
                {yearNotes[section.yearBucket] && (
                  <span class="archive-accordion-note">{yearNotes[section.yearBucket]}</span>
                )}
                <span class="archive-accordion-count" data-count data-total={section.count}>
                  {section.count} 篇
                </span>
              </summary>
              <div class="archive-accordion-body">
                <div class="archive-accordion-body-inner">
                  <ul class="archive-list">
                    {section.posts.map((post) => {
                      const topics = post.topics ?? ["公共網路"];
                      return (
                        <li class="archive-item">
                          <time class="archive-date" datetime={post.pubDate.toISOString()}>
                            {formatDate(post.pubDate)}
                          </time>
                          <div class="archive-main">
                            <a class="archive-link" href={post.url}>
                              {post.title}
                            </a>
                            <p class="archive-meta">
                              <span class="archive-meta-topics">主題：{topics.join("・")}</span>
                              {isRecentlyUpdated(post.pubDate, post.updatedDate) && (
                                <span
                                  class="archive-update-badge"
                                  title={`近 ${RECENT_UPDATED_DAYS} 天內更新`}
                                >
                                  最近更新
                                </span>
                              )}
                            </p>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            </details>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>

<script is:inline>
  const track = (name, props = {}) => {
    if (typeof window.mbTrack === "function") window.mbTrack(name, props);
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const link = target.closest(".archive-link");
    if (!(link instanceof HTMLAnchorElement)) return;
    track("Archive Post Click", { source: "blog_archive" });
  });
</script>
