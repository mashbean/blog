---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPostUrl, getPostCanonicalPathSegment, getPostPathCandidates } from "@/utils/blog";
import { formatDate } from "@/utils/date";
import { withBase } from "@/utils/paths";
import { cleanPostTitle } from "@/utils/title";
import { resolveCoverPath } from "@/utils/cover";
import { type ClassifiedTags } from "@/utils/blogTags";
import { buildBlogPageData } from "@/utils/blogPageData";
import { topicToRouteSegment } from "@/utils/topicRoutes";
import { verifyArticleSignature } from "@/utils/articleSignature";
import { isWeb3FeatureEnabled, requireWeb3PublicConfig } from "@/utils/web3Config";
import { resolveConfiguredEnsProfile } from "@/utils/ens";
import Web3TipJar from "@/components/Web3TipJar.astro";
import LegacyRedirect from "@/components/LegacyRedirect.astro";

const blogPageDataPromise = buildBlogPageData({
  includeDrafts: !import.meta.env.PROD,
  includeFuture: !import.meta.env.PROD
});

export async function getStaticPaths() {
  const includeLegacyPaths = process.env.FAST_BUILD !== "1";
  const { posts, contextById } = await buildBlogPageData({
    includeDrafts: !import.meta.env.PROD,
    includeFuture: !import.meta.env.PROD
  });

  return posts.flatMap((post) => {
    const canonical = getPostCanonicalPathSegment(post);
    const context = contextById.get(post.id)!;
    const pathCandidates = includeLegacyPaths
      ? getPostPathCandidates(post, { includeVerboseLegacy: true })
      : [canonical];
    return pathCandidates.map((segment) => ({
      params: { slug: segment },
      props: {
        post,
        isLegacyPath: segment !== canonical,
        newerPostId: context.newerPostId,
        olderPostId: context.olderPostId,
        relatedPostIds: context.relatedPostIds,
        classifiedCurrent: context.classifiedCurrent
      }
    }));
  });
}

const { post, isLegacyPath = false, newerPostId = null, olderPostId = null, relatedPostIds = [], classifiedCurrent } = Astro.props as {
  post: CollectionEntry<"blog">;
  isLegacyPath?: boolean;
  newerPostId?: string | null;
  olderPostId?: string | null;
  relatedPostIds?: string[];
  classifiedCurrent: ClassifiedTags;
};
const postsById = !isLegacyPath
  ? (await blogPageDataPromise).postsById
  : new Map<string, CollectionEntry<"blog">>();
let Content: any = null;
let headings: { depth: number; slug: string; text: string }[] = [];
if (!isLegacyPath) {
  const renderedPost = await render(post);
  Content = renderedPost.Content;
  headings = renderedPost.headings;
}

// 對應的翻譯版本（translations collection 以 translationOf 指回本文 id）。
// 翻譯與原文共用同一網址，由前端切換顯示，不另外產生頁面。
let translation: CollectionEntry<"translations"> | null = null;
let TranslationContent: any = null;
let translationHeadings: { depth: number; slug: string; text: string }[] = [];
if (!isLegacyPath) {
  const translationEntries = await getCollection(
    "translations",
    (entry: CollectionEntry<"translations">) => entry.data.translationOf === post.id
  );
  translation = translationEntries[0] ?? null;
  if (translation) {
    const renderedTranslation = await render(translation);
    TranslationContent = renderedTranslation.Content;
    translationHeadings = renderedTranslation.headings;
  }
}
const postTitle = cleanPostTitle(post.data.title);
const signatureCheck = !isLegacyPath
  ? verifyArticleSignature(
      {
        slug: post.id,
        title: post.data.title,
        description: post.data.description,
        pubDateISO: post.data.pubDate.toISOString(),
        updatedDateISO: post.data.updatedDate?.toISOString(),
        body: post.body ?? ""
      },
      {
        contentHash: post.data.contentHash,
        signature: post.data.signature,
        signer: post.data.signer,
        signatureVersion: post.data.signatureVersion
      }
    )
  : {
      status: "unsigned" as const,
      reason: "Legacy redirect",
      computedHash: "",
      recoveredAddress: null,
      expectedSigner: null
    };
const signatureBadgeState =
  signatureCheck.status === "verified"
    ? "verified"
    : signatureCheck.status === "unsigned"
      ? "unsigned"
      : "invalid";
const signatureBadgeText =
  signatureCheck.status === "verified"
    ? "已簽名"
    : signatureCheck.status === "unsigned"
      ? "未簽名"
      : "簽名異常";
const signatureBadgeTitle =
  signatureCheck.status === "verified"
    ? "已驗證簽名"
    : signatureCheck.status === "unsigned"
      ? "此篇文章尚未簽名"
      : "簽名資料需更新";
const signatureHash = post.data.contentHash ?? signatureCheck.computedHash;
const web3Enabled = !isLegacyPath && isWeb3FeatureEnabled();
const web3Config = web3Enabled ? requireWeb3PublicConfig() : null;
const tipEnsProfile = web3Config
  ? await resolveConfiguredEnsProfile(web3Config.tipEnsName, web3Config.tipAddress)
  : null;
const signerEnsName = web3Config?.signerEnsName ?? "";
const signerEnsStatusText = signerEnsName
  ? signatureCheck.status === "verified"
    ? "已驗證"
    : signatureCheck.status === "unsigned"
      ? "未簽名"
      : "簽名異常"
  : "未設定";
const resolvedCover = !isLegacyPath ? resolveCoverPath(post.data.cover) : null;
const coverSrc = resolvedCover
  ? /^https?:\/\//.test(resolvedCover.primary)
    ? resolvedCover.primary
    : withBase(resolvedCover.primary)
  : undefined;
const coverFallbackSrc = resolvedCover?.fallback
  ? /^https?:\/\//.test(resolvedCover.fallback)
    ? resolvedCover.fallback
    : withBase(resolvedCover.fallback)
  : undefined;
const imageFallbackHandler =
  "if(this.dataset.fallback){this.src=this.dataset.fallback;this.removeAttribute('data-fallback');}";

const canonicalURL = post.data.canonicalURL;
const pageURL = canonicalURL ??
  (Astro.site ? new URL(buildPostUrl(post), Astro.site).toString() : buildPostUrl(post));
const canonicalPostURL = Astro.site ? new URL(buildPostUrl(post), Astro.site).toString() : buildPostUrl(post);
const effectiveCanonicalURL = isLegacyPath ? canonicalPostURL : canonicalURL;

const coverURL = coverSrc
  ? /^https?:\/\//.test(coverSrc)
    ? coverSrc
    : Astro.site
      ? new URL(coverSrc, Astro.site).toString()
      : coverSrc
  : undefined;

const computeReadingMinutes = (body: string): number => {
  const plain = body
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/\[(.*?)\]\((.*?)\)/g, "$1 ");
  const latinWords = (plain.match(/[A-Za-z0-9_]+/g) ?? []).length;
  const cjkChars = (plain.match(/[\u4E00-\u9FFF\u3400-\u4DBF\u3040-\u30FF]/g) ?? []).length;
  const mixedWordCount = latinWords + cjkChars / 2;
  return Math.max(1, Math.round(mixedWordCount / 220));
};

const readingMinutes = !isLegacyPath ? computeReadingMinutes(post.body ?? "") : 0;
const translationReadingMinutes = translation
  ? computeReadingMinutes(translation.body ?? "")
  : 0;

const tocHeadings = headings.filter((item) => item.depth === 2 || item.depth === 3);
const translationTocHeadings = translationHeadings.filter(
  (item) => item.depth === 2 || item.depth === 3
);

const newerPost = !isLegacyPath && newerPostId ? postsById.get(newerPostId) ?? null : null;
const olderPost = !isLegacyPath && olderPostId ? postsById.get(olderPostId) ?? null : null;
const relatedPosts = !isLegacyPath
  ? relatedPostIds
      .map((itemId) => postsById.get(itemId))
      .filter((item): item is CollectionEntry<"blog"> => Boolean(item))
  : [];

const articleStructuredData = !isLegacyPath
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: postTitle,
      description: post.data.description,
      inLanguage: post.data.lang ?? "zh-TW",
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      author: {
        "@type": "Person",
        name: post.data.author ?? "Mashbean"
      },
      mainEntityOfPage: pageURL,
      image: coverURL ? [coverURL] : undefined
    }
  : null;
---

{
  isLegacyPath ? (
    <LegacyRedirect canonicalPath={buildPostUrl(post)} canonicalURL={canonicalPostURL} />
  ) : (
    <BaseLayout
      title={postTitle}
      description={post.data.description}
      canonicalURL={effectiveCanonicalURL}
      ogImage={resolvedCover?.primary ?? post.data.cover}
      ogType="article"
      structuredData={articleStructuredData}
      isArticle={true}
      lang={post.data.lang ?? "zh-TW"}
    >
  <article class="article-layout" data-active-lang="zh">
    <div class="article-main">
      <header class="article-header">
        <h1 class="article-title">
          {translation ? (
            <>
              <span class="lang-variant lang-zh">{postTitle}</span>
              <span class="lang-variant lang-en" lang="en">{cleanPostTitle(translation.data.title)}</span>
            </>
          ) : (
            postTitle
          )}
        </h1>
        {translation && (
          <div class="lang-toggle" role="group" aria-label="切換語言 Switch language">
            <button type="button" class="lang-toggle-btn is-active" data-lang-btn="zh">中文</button>
            <button type="button" class="lang-toggle-btn" data-lang-btn="en">English</button>
          </div>
        )}
        <div class="article-meta-row">
          <p class="article-meta">
            {translation ? (
              <>
                <span class="lang-variant lang-zh">發布：</span>
                <span class="lang-variant lang-en">Published: </span>
              </>
            ) : (
              "發布："
            )}
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {translation ? (
              <>
                <span class="lang-variant lang-zh">{` · 約 ${readingMinutes} 分鐘閱讀`}</span>
                <span class="lang-variant lang-en">{` · ${translationReadingMinutes} min read`}</span>
              </>
            ) : (
              ` · 約 ${readingMinutes} 分鐘閱讀`
            )}
            {
              post.data.updatedDate && (
                <>
                  {" · 更新："}
                  <time datetime={post.data.updatedDate.toISOString()}>
                    {formatDate(post.data.updatedDate)}
                  </time>
                </>
              )
            }
            {post.data.draft && !import.meta.env.PROD && " · 草稿"}
          </p>
        </div>
        {web3Enabled && (
          <details
            class:list={{
              "signature-disclosure": true,
              "signature-disclosure-verified": signatureBadgeState === "verified",
              "signature-disclosure-unsigned": signatureBadgeState === "unsigned",
              "signature-disclosure-invalid": signatureBadgeState === "invalid"
            }}
          >
            <summary
              class:list={{
                "signature-badge": true,
                "signature-badge-verified": signatureBadgeState === "verified",
                "signature-badge-unsigned": signatureBadgeState === "unsigned",
                "signature-badge-invalid": signatureBadgeState === "invalid"
              }}
              title={signatureBadgeTitle}
              aria-label={`${signatureBadgeTitle}（點擊查看簽名細節）`}
            >
              {
                signatureBadgeState === "verified" ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5Zm-1.4 12.1-2.7-2.72 1.2-1.2 1.5 1.52 4.23-4.22 1.2 1.2-5.43 5.42Z" />
                  </svg>
                ) : signatureBadgeState === "unsigned" ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5Zm0 4.4a1.15 1.15 0 0 1 1.15 1.15v5.05a1.15 1.15 0 1 1-2.3 0V8.3A1.15 1.15 0 0 1 12 7.15Zm0 9.15a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3.25 2.5 20.75h19L12 3.25Zm0 4.1 6.14 11.3H5.86L12 7.35Zm-1.1 3.75v3.45h2.2V11.1h-2.2Zm0 4.65v1.95h2.2v-1.95h-2.2Z" />
                  </svg>
                )
              }
              <span>{signatureBadgeText}</span>
              <span class="signature-badge-caret" aria-hidden="true">▾</span>
            </summary>
            <div class="signature-panel">
              <div class="signature-panel-head">
                <span class="signature-panel-title">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5Zm-1.4 12.1-2.7-2.72 1.2-1.2 1.5 1.52 4.23-4.22 1.2 1.2-5.43 5.42Z" />
                  </svg>
                  已簽名資訊
                </span>
                <button type="button" class="signature-panel-close" aria-label="關閉已簽名資訊">
                  關閉
                </button>
              </div>
              <p>
                <strong>豆泥的以太坊地址：</strong>
                {signerEnsName}
              </p>
              <p>
                <strong>狀態：</strong>
                {signerEnsStatusText}
              </p>
              <div class="signature-explain-row">
                <details class="signature-explain">
                  <summary class="signature-explain-btn">文章的身分證字號</summary>
                  <p>
                    <code>{signatureHash}</code>
                  </p>
                </details>
                <details class="signature-explain">
                  <summary class="signature-explain-btn">這是什麼？</summary>
                  <p>
                    已簽名表示這篇文章已建立獨特的身分證字號（內容雜湊，contentHash）並且由豆泥簽署認證，簽署是採用以太坊區塊鏈的豆泥專用地址（signer.mashbean.eth）。只要內容一經修改，就會需要重新驗證換發新的身分證字號。但豆泥不是每天都在公所上班，所以偶爾會慢一點認證。
                  </p>
                </details>
              </div>
            </div>
          </details>
        )}
        {post.data.author && <p class="article-author">作者：{post.data.author}</p>}
        {post.data.lead && (
          <p class:list={{ "article-lead": true, "lang-variant": Boolean(translation), "lang-zh": Boolean(translation) }}>
            {post.data.lead}
          </p>
        )}
        {translation?.data.lead && (
          <p class="article-lead lang-variant lang-en" lang="en">{translation.data.lead}</p>
        )}

        {classifiedCurrent.topics.length > 0 && (
          <ul class="tag-list" aria-label="文章標籤">
            {classifiedCurrent.topics.map((topic) => (
              <li class="tag-list-item">
                <a class="tag-list-link" href={withBase(`tags/${topicToRouteSegment(topic)}/`)}>
                  {topic}
                </a>
              </li>
            ))}
          </ul>
        )}

        <div class="reading-tools" role="group" aria-label="閱讀偏好">
          <span class="reading-tools-label">閱讀偏好</span>
          <button id="reading-font-dec" type="button" class="reading-tool-btn" aria-label="縮小字級">
            A-
          </button>
          <button id="reading-font-inc" type="button" class="reading-tool-btn" aria-label="放大字級">
            A+
          </button>
        </div>
      </header>

      {coverSrc && (
        <figure class="article-cover">
          <img
            src={coverSrc}
            data-fallback={coverFallbackSrc}
            onerror={imageFallbackHandler}
            alt={post.data.coverAlt ?? postTitle}
            loading="lazy"
          />
        </figure>
      )}

      <div class="article-prose">
        {translation ? (
          <>
            <div class="lang-variant lang-zh">
              <Content />
            </div>
            <div class="lang-variant lang-en" lang="en">
              <TranslationContent />
            </div>
          </>
        ) : (
          <Content />
        )}
      </div>

      <nav class="article-pagination" aria-label="文章導覽">
        <div>
          <small>較新文章</small>
          {newerPost ? (
            <a href={buildPostUrl(newerPost)}>{cleanPostTitle(newerPost.data.title)}</a>
          ) : (
            <span>目前已是最新</span>
          )}
        </div>
        <div>
          <small>較舊文章</small>
          {olderPost ? (
            <a href={buildPostUrl(olderPost)}>{cleanPostTitle(olderPost.data.title)}</a>
          ) : (
            <span>目前已是最舊</span>
          )}
        </div>
      </nav>

      {relatedPosts.length > 0 && (
        <section class="related-posts" aria-label="相關文章">
          <h2>相關文章</h2>
          <ul class="post-list-compact">
            {relatedPosts.map((item) => (
              <li class="post-list-compact-item">
                <a class="post-list-compact-link" href={buildPostUrl(item)}>{cleanPostTitle(item.data.title)}</a>
                <small class="post-list-compact-date">({formatDate(item.data.pubDate)})</small>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="article-back-link">
        <a href={withBase("blog/")}>← 回文章列表</a>
      </p>
    </div>

    <aside class="article-sidebar" aria-label="文章目錄與分享">
      <div class="toc-card">
        {tocHeadings.length > 0 && (
          <>
            <h2>
              {translation ? (
                <>
                  <span class="lang-variant lang-zh">目錄</span>
                  <span class="lang-variant lang-en" lang="en">Contents</span>
                </>
              ) : (
                "目錄"
              )}
            </h2>
            <ol class:list={{ "toc-list": true, "lang-variant": Boolean(translation), "lang-zh": Boolean(translation) }}>
              {tocHeadings.map((item) => (
                <li class:list={{ "toc-item": true, "toc-item-depth-3": item.depth === 3 }}>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))}
            </ol>
            {translation && translationTocHeadings.length > 0 && (
              <ol class="toc-list lang-variant lang-en" lang="en">
                {translationTocHeadings.map((item) => (
                  <li class:list={{ "toc-item": true, "toc-item-depth-3": item.depth === 3 }}>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </>
        )}
        <div class="toc-share-card">
          <button id="article-copy-link" type="button" class="toc-share-btn">分享本文</button>
        </div>
        {web3Enabled && web3Config && tipEnsProfile && (
          <Web3TipJar ensName={web3Config.tipEnsName} chainId={web3Config.chainId} ens={tipEnsProfile} />
        )}
      </div>
    </aside>
  </article>
    </BaseLayout>
  )
}

{
  !isLegacyPath && (
    <script is:inline define:vars={{ pageURL }}>
      const copyButton = document.querySelector("#article-copy-link");

      copyButton?.addEventListener("click", async () => {
        if (!(copyButton instanceof HTMLButtonElement)) return;
        const originalLabel = copyButton.textContent;
        try {
          await navigator.clipboard.writeText(pageURL);
          copyButton.textContent = "已複製";
          if (typeof window.mbTrack === "function") {
            window.mbTrack("Share Link Copied", { location: "toc_share" });
          }
        } catch {
          copyButton.textContent = "複製失敗";
        }
        window.setTimeout(() => {
          copyButton.textContent = originalLabel ?? "分享本文";
        }, 1200);
      });
    </script>
  )
}

{
  !isLegacyPath && translation && (
    <script is:inline>
      (() => {
        const article = document.querySelector(".article-layout");
        const buttons = Array.from(document.querySelectorAll("[data-lang-btn]"));
        if (!article || buttons.length === 0) return;

        const setLang = (lang, updateUrl) => {
          article.setAttribute("data-active-lang", lang);
          document.documentElement.lang = lang === "en" ? "en" : "zh-TW";
          buttons.forEach((btn) => {
            const isActive = btn.getAttribute("data-lang-btn") === lang;
            btn.classList.toggle("is-active", isActive);
            btn.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
          if (updateUrl) {
            const url = new URL(window.location.href);
            if (lang === "en") {
              url.searchParams.set("lang", "en");
            } else {
              url.searchParams.delete("lang");
            }
            window.history.replaceState(null, "", url);
          }
        };

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const lang = btn.getAttribute("data-lang-btn") || "zh";
            setLang(lang, true);
            if (typeof window.mbTrack === "function") {
              window.mbTrack("Article Language Switched", { lang });
            }
          });
        });

        const params = new URLSearchParams(window.location.search);
        if (params.get("lang") === "en") setLang("en", false);
      })();
    </script>
  )
}

{
  !isLegacyPath && (
    <script is:inline>
      const signatureDisclosures = Array.from(document.querySelectorAll(".signature-disclosure"));
      signatureDisclosures.forEach((panel) => {
        if (!(panel instanceof HTMLDetailsElement)) return;
        const closeButton = panel.querySelector(".signature-panel-close");
        if (!(closeButton instanceof HTMLButtonElement)) return;
        closeButton.addEventListener("click", () => {
          panel.open = false;
        });
      });
    </script>
  )
}
