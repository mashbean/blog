---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPostUrl, getBlogPosts } from "@/utils/blog";
import { formatDate } from "@/utils/date";
import { classifyPostTags, getTopicCatalog } from "@/utils/blogTags";

const allPosts = await getBlogPosts();
const topicCatalog = getTopicCatalog();
const postClassified = allPosts.map((post) => ({
  post,
  classified: classifyPostTags({
    title: post.data.title,
    description: post.data.description,
    body: post.body,
    tags: post.data.tags
  })
}));

const tagSections = topicCatalog.map((item) => {
  const scoped = postClassified.filter((entry) => entry.classified.topics.includes(item.key));
  const posts = scoped.map((entry) => entry.post);
  const keywordCount = new Map<string, number>();
  for (const entry of scoped) {
    for (const keyword of entry.classified.keywords) {
      keywordCount.set(keyword, (keywordCount.get(keyword) ?? 0) + 1);
    }
  }
  const topKeywords = Array.from(keywordCount.entries())
    .sort((a, b) => b[1] - a[1])
    .slice(0, 10);

  return {
    ...item,
    posts,
    count: posts.length,
    topKeywords
  };
});
---

<BaseLayout title="標籤" description="依核心標籤探索文章。">
  <h1 class="section-title">標籤</h1>
  <p>目前我的興趣包含這六種主題，選擇標籤讓您更容易找到好文章。</p>

  <div class="archive-accordion-list" aria-label="標籤文章收合列表">
    {
      tagSections.map((item, index) => (
        <details class="archive-accordion" open={index === 0}>
          <summary class="archive-accordion-summary">
            <span class="archive-accordion-title">
              {item.title}
            </span>
            <span class="archive-accordion-count">{item.count} 篇</span>
          </summary>
          <div class="archive-accordion-body">
            <div class="archive-accordion-body-inner">
              <p class="archive-accordion-description">{item.description}</p>
              {
                item.posts.length === 0 ? (
                  <p class="empty-state">目前沒有文章。</p>
                ) : (
                  <>
                    {item.topKeywords.length > 0 && (
                      <ul class="archive-keyword-chips" aria-label={`${item.title} 熱門關鍵字`}>
                        {item.topKeywords.map(([keyword, count]) => (
                          <li>
                            <span>{keyword}</span>
                            <small>{count}</small>
                          </li>
                        ))}
                      </ul>
                    )}
                    <ul class="archive-list">
                      {item.posts.map((post) => (
                        <li class="archive-item">
                          <time class="archive-date" datetime={post.data.pubDate.toISOString()}>
                            {formatDate(post.data.pubDate)}
                          </time>
                          <div class="archive-main">
                            <a class="archive-link" href={buildPostUrl(post)}>{post.data.title}</a>
                            <p class="archive-meta">
                              {post.data.category ? `分類：${post.data.category}` : "分類：未分類"}
                            </p>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </>
                )
              }
            </div>
          </div>
        </details>
      ))
    }
  </div>
</BaseLayout>
