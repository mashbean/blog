---
import { getTopicCatalog } from "@/utils/blogTags";
import { withBase } from "@/utils/paths";

export async function getStaticPaths() {
  return getTopicCatalog().map((topic) => ({
    params: { topic: topic.key },
    props: { topic: topic.key, title: topic.title }
  }));
}

const { topic, title } = Astro.props as { topic: string; title: string };
const destination = withBase(`tags/?topic=${encodeURIComponent(topic)}`);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} 標籤導向中</title>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={destination} />
  </head>
  <body>
    <p>
      正在前往標籤頁：<a href={destination}>{title}</a>
    </p>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </body>
</html>
