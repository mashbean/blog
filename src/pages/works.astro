---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WorkCard from "@/components/WorkCard.astro";
import { workGroups, works } from "@/data/works";

const groups = (Object.keys(workGroups) as Array<keyof typeof workGroups>).map((key) => ({
  key,
  ...workGroups[key],
  items: works.filter((work) => work.group === key),
}));
---

<BaseLayout
  title="作品集 / Works"
  description="豆泥（mashbean）的數位手作攤位：個人實驗與馬特市的開源公共設施。"
>
  <div class="home-section-head">
    <h1 class="section-title" style="margin-top: 0;">作品集</h1>
  </div>

  {
    groups.map((group) => (
      <section class="work-group" aria-label={group.title}>
        <div class="work-group-head">
          <h2 class="work-group-title">{group.title}</h2>
        </div>
        <ul class="work-grid">
          {group.items.map((work) => (
            <li>
              <WorkCard work={work} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .work-group {
    margin-top: 1.6rem;
  }
  .work-group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    margin-bottom: 0.7rem;
  }
  .work-group-title {
    margin: 0;
    font-size: 1.3rem;
  }
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 0.8rem;
  }
  .work-grid > li {
    min-width: 0;
  }
</style>
