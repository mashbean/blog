---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { DEFAULT_OG_IMAGE, SITE_DESCRIPTION, SITE_LANG, SITE_TITLE } from "@/site.config";
import { withBase } from "@/utils/paths";
import siteBehaviorsScript from "@/scripts/site-behaviors.ts?url";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  structuredData?: Record<string, unknown> | null;
  isArticle?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalURL,
  ogImage,
  ogType = "website",
  noindex = false,
  structuredData = null,
  isArticle = false
} = Astro.props as Props;

const tabTitle = "mashbean blog";
const seoTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;

const canonical =
  canonicalURL ??
  (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.href);

const ogPath = ogImage
  ? /^https?:\/\//.test(ogImage)
    ? ogImage
    : withBase(ogImage)
  : withBase(DEFAULT_OG_IMAGE);

const ogImageURL =
  /^https?:\/\//.test(ogPath)
    ? ogPath
    : Astro.site
      ? new URL(ogPath, Astro.site).toString()
      : new URL(ogPath, Astro.url).toString();

const logoPath = withBase("images/favicon-512.png");
const logoURL =
  Astro.site
    ? new URL(logoPath, Astro.site).toString()
    : new URL(logoPath, Astro.url).toString();

const siteURL = Astro.site?.toString() ?? new URL(withBase(""), Astro.url).toString();
const plausibleDomain = (import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? "").trim();
const plausibleScriptSrc = (import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_SRC ?? "https://plausible.io/js/script.js").trim();
const siteStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteURL}#organization`,
      name: "mashbean blog",
      url: siteURL,
      logo: {
        "@type": "ImageObject",
        url: logoURL
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL,
      name: "mashbean blog",
      publisher: {
        "@id": `${siteURL}#organization`
      }
    }
  ]
};
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src={plausibleScriptSrc}></script>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteStructuredData)} />
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <link rel="shortcut icon" href={withBase("images/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("images/favicon-16.png")} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("images/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase("images/favicon-512.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("images/apple-touch-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-is-article={isArticle ? "1" : "0"} data-search-path={withBase("search/")}>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    {isArticle && (
      <div class="reading-progress" aria-hidden="true">
        <span id="reading-progress-bar"></span>
      </div>
    )}
    <Header />
    <main id="main-content" class="container page-shell">
      <slot />
    </main>
    {isArticle && (
      <button
        id="reading-focus-toggle"
        type="button"
        class="reading-focus-fab"
        aria-pressed="false"
      >
        聚焦閱讀
      </button>
    )}
    {isArticle && (
      <p id="reading-focus-hint" class="reading-focus-hint" hidden>
        已進入聚焦閱讀，可點選下方按鈕解除
      </p>
    )}
    <Footer />
    <script type="module" is:inline src={siteBehaviorsScript}></script>
  </body>
</html>
