---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WorkCard from "@/components/WorkCard.astro";
import { workGroups, works } from "@/data/works";
import { useTranslations } from "@/i18n/ui";
import { DEFAULT_LOCALE, type Locale } from "@/site.config";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props as Props;
const t = useTranslations(lang);
const isEn = lang === "en";

const groups = (Object.keys(workGroups) as Array<keyof typeof workGroups>).map((key) => ({
  key,
  title: isEn ? workGroups[key].titleEn : workGroups[key].title,
  items: works.filter((work) => work.group === key),
}));
---

<BaseLayout title={t.works.metaTitle} description={t.works.metaDescription} lang={lang}>
  <div class="home-section-head">
    <h1 class="section-title" style="margin-top: 0;">{t.works.heading}</h1>
  </div>

  {
    groups.map((group) => (
      <section class="work-group" aria-label={group.title}>
        <div class="work-group-head">
          <h2 class="work-group-title">{group.title}</h2>
        </div>
        <ul class="work-grid">
          {group.items.map((work) => (
            <li>
              <WorkCard work={work} lang={lang} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .work-group {
    margin-top: 1.6rem;
  }
  .work-group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    margin-bottom: 0.7rem;
  }
  .work-group-title {
    margin: 0;
    font-size: 1.3rem;
  }
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 0.8rem;
  }
  .work-grid > li {
    min-width: 0;
  }
</style>
