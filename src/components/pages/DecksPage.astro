---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DeckCard from "@/components/DeckCard.astro";
import { getDecks } from "@/data/decks";
import { useTranslations } from "@/i18n/ui";
import { DEFAULT_LOCALE, type Locale } from "@/site.config";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props as Props;
const t = useTranslations(lang);

const decks = getDecks();
---

<BaseLayout title={t.decks.metaTitle} description={t.decks.metaDescription} lang={lang}>
  <div class="home-section-head">
    <h1 class="section-title" style="margin-top: 0;">{t.decks.heading}</h1>
    <p class="home-section-meta">{t.decks.meta(decks.length)}</p>
  </div>

  {
    decks.length === 0 ? (
      <p>{t.decks.empty}</p>
    ) : (
      <ul class="deck-list" aria-label={t.decks.listAria}>
        {decks.map((deck) => (
          <li>
            <DeckCard deck={deck} lang={lang} />
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .deck-list {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
</style>
