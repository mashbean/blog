---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/paths";
import { useTranslations } from "@/i18n/ui";
import { DEFAULT_LOCALE, type Locale } from "@/site.config";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props as Props;
const t = useTranslations(lang);

// 英文頁指向英文 feed，中文頁指向中文 feed。
const feedPath = lang === "en" ? withBase("en/rss.xml") : withBase("rss.xml");
const feedUrl = Astro.site ? new URL(feedPath, Astro.site).toString() : feedPath;
const encodedFeedUrl = encodeURIComponent(feedUrl);
---

<BaseLayout title={t.subscribe.metaTitle} description={t.subscribe.metaDescription} lang={lang}>
  <section class="subscribe-panel">
    <h1 class="section-title" style="margin-top:0;">{t.subscribe.heading}</h1>
    <p>{t.subscribe.intro}</p>

    <ol class="subscribe-steps">
      <li><strong>{t.subscribe.step1[0]}</strong>{t.subscribe.step1[1]}</li>
      <li><strong>{t.subscribe.step2[0]}</strong>{t.subscribe.step2[1]}</li>
      <li><strong>{t.subscribe.step3[0]}</strong>{t.subscribe.step3[1]}</li>
    </ol>

    <div class="subscribe-feed-box">
      <label for="rss-feed-url"><strong>{t.subscribe.feedUrl}</strong></label>
      <code id="rss-feed-url">{feedUrl}</code>
      <button id="rss-copy-btn" class="nav-link" type="button" data-copied={t.subscribe.copied} data-copy-failed={t.subscribe.copyFailed}>{t.subscribe.copy}</button>
      <p id="rss-copy-status" class="subscribe-note" aria-live="polite"></p>
    </div>

    <div class="subscribe-actions">
      <a class="nav-link" href={`https://feedly.com/i/subscription/feed/${encodedFeedUrl}`} target="_blank" rel="noopener noreferrer">{t.subscribe.openFeedly}</a>
      <a class="nav-link" href={`https://www.inoreader.com/?add_feed=${encodedFeedUrl}`} target="_blank" rel="noopener noreferrer">{t.subscribe.openInoreader}</a>
    </div>
  </section>

  <script is:inline>
    const copyBtn = document.getElementById("rss-copy-btn");
    const feedUrlNode = document.getElementById("rss-feed-url");
    const copyStatus = document.getElementById("rss-copy-status");

    copyBtn?.addEventListener("click", async () => {
      const text = (feedUrlNode?.textContent || "").trim();
      if (!text || !copyStatus) return;

      try {
        await navigator.clipboard.writeText(text);
        copyStatus.textContent = copyBtn.dataset.copied || "";
      } catch {
        copyStatus.textContent = copyBtn.dataset.copyFailed || "";
      }
    });
  </script>
</BaseLayout>
