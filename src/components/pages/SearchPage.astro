---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase, localizePath } from "@/utils/paths";
import { DEFAULT_LOCALE, type Locale } from "@/site.config";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props as Props;
const isEn = lang === "en";

// 英文搜尋抓英文索引；中文抓原索引。
const fallbackIndexUrl = isEn ? withBase("en/search-index.json") : withBase("search-index.json");
const graphHref = localizePath("tags-graph/", lang);
const dateLocale = isEn ? "en-CA" : "zh-TW";

const s = isEn
  ? {
      metaTitle: "Search",
      metaDescription: "Search articles and page content across the site.",
      heading: "Search",
      intro: "Quickly find articles and page content across the site.",
      panelAria: "Site search",
      loading: "Loading search index…",
      idle: "Type a keyword to start searching.",
      empty: "No matching results — try a different keyword.",
      error: "Search is temporarily unavailable. Please try again later.",
      inputAria: "Search keyword",
      placeholder: "e.g. privacy, Matters, d/acc, 2024",
      submit: "Search",
      graphText: "Explore mashbean's brain",
      graph3d: "3D search",
      // JS 用：
      results: (n: number) => `${n} results`,
      noResults: "No matching results.",
      loadFailed: "Failed to load the search index. Please try again later.",
      hit: "Match: ",
      zoneTitle: "Title",
      zoneDesc: "Summary",
      zoneBody: "Body",
      zoneTags: "Tags",
      typePost: "Article",
      typeFacebook: "Facebook post",
      typePage: "Page"
    }
  : {
      metaTitle: "搜尋",
      metaDescription: "搜尋站內文章與頁面內容。",
      heading: "搜尋",
      intro: "快速查找全站文章與頁面內容。",
      panelAria: "站內搜尋",
      loading: "搜尋索引載入中...",
      idle: "請輸入關鍵字開始搜尋。",
      empty: "找不到符合的結果，請換個關鍵字。",
      error: "搜尋暫時不可用，請稍後再試。",
      inputAria: "搜尋關鍵字",
      placeholder: "例如：隱私、Matters、d/acc、2024",
      submit: "搜尋",
      graphText: "與豆泥的大腦互動",
      graph3d: "3D 搜尋",
      results: (n: number) => `${n} 筆結果`,
      noResults: "找不到符合的結果。",
      loadFailed: "搜尋索引載入失敗，請稍後再試。",
      hit: "命中：",
      zoneTitle: "標題",
      zoneDesc: "摘要",
      zoneBody: "內文",
      zoneTags: "標籤",
      typePost: "精選文章",
      typeFacebook: "臉書文",
      typePage: "頁面"
    };

// 傳入 client script 的字串（含 index url 與日期地區）。
const js = {
  indexUrl: fallbackIndexUrl,
  dateLocale,
  results0: s.results(0),
  resultsSuffix: isEn ? " results" : " 筆結果",
  noResults: s.noResults,
  loadFailed: s.loadFailed,
  idle: s.idle,
  hit: s.hit,
  zoneTitle: s.zoneTitle,
  zoneDesc: s.zoneDesc,
  zoneBody: s.zoneBody,
  zoneTags: s.zoneTags,
  typePost: s.typePost,
  typeFacebook: s.typeFacebook,
  typePage: s.typePage
};
---

<BaseLayout title={s.metaTitle} description={s.metaDescription} lang={lang}>
  <h1 class="section-title">{s.heading}</h1>
  <p class="search-intro">{s.intro}</p>

  <section class="search-panel" aria-label={s.panelAria}>
    <p id="search-status" class="search-status" aria-live="polite" hidden></p>
    <div id="search-state-stack" class="search-state-stack" aria-live="polite">
      <p class="search-state" data-state="loading" hidden>{s.loading}</p>
      <p class="search-state" data-state="idle" hidden>{s.idle}</p>
      <p class="search-state" data-state="empty" hidden>{s.empty}</p>
      <p class="search-state search-state-error" data-state="error" hidden>
        {s.error}
      </p>
    </div>
    <div id="search-fallback" class="search-fallback">
      <form id="site-search-form" class="search-form" role="search">
        <div class="search-form-row">
          <input
            id="site-search-input"
            type="search"
            inputmode="search"
            autocomplete="off"
            aria-label={s.inputAria}
            placeholder={s.placeholder}
          />
          <button type="submit" class="nav-link">{s.submit}</button>
        </div>
      </form>
      <p id="site-search-count" class="search-result-count" hidden></p>
      <ul id="site-search-results" class="search-results"></ul>
    </div>
  </section>
  <p class="search-graph-cta">
    <span class="search-graph-cta-text">{s.graphText}</span>
    <a class="search-graph-cta-btn" href={graphHref}>{s.graph3d}</a>
  </p>
</BaseLayout>

<script is:inline define:vars={{ js }}>
  const track = (name, props = {}) => {
    if (typeof window.mbTrack === "function") window.mbTrack(name, props);
  };

  const query = new URLSearchParams(window.location.search).get("q") ?? "";
  const fallbackForm = document.querySelector("#site-search-form");
  const fallbackInput = document.querySelector("#site-search-input");
  const fallbackResults = document.querySelector("#site-search-results");
  const fallbackCount = document.querySelector("#site-search-count");
  const stateNodes = Array.from(document.querySelectorAll(".search-state"));
  const status = document.querySelector("#search-status");

  const setSearchState = (nextState) => {
    stateNodes.forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      node.hidden = node.dataset.state !== nextState;
    });
  };

  const setStatus = (message = "") => {
    if (!(status instanceof HTMLElement)) return;
    status.textContent = message;
    status.hidden = message.length === 0;
  };

  const normalize = (value) => value.toLocaleLowerCase("zh-TW").normalize("NFKC").trim();
  const tokenize = (value) => normalize(value).split(/\s+/).filter(Boolean);
  const escapeHTML = (value) =>
    value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const highlight = (value, tokens) => {
    const safe = escapeHTML(value ?? "");
    if (!tokens.length) return safe;
    const pattern = tokens
      .filter((token) => token.length >= 2)
      .map((token) => escapeRegExp(token))
      .join("|");
    if (!pattern) return safe;
    return safe.replace(new RegExp(`(${pattern})`, "gi"), "<mark>$1</mark>");
  };

  const scoreDoc = (doc, tokens) => {
    const titleText = normalize(doc.title ?? "");
    const descText = normalize(doc.description ?? "");
    const bodyText = normalize(doc.content ?? "");
    const tagText = normalize((doc.tags ?? []).join(" "));
    let score = 0;
    for (const token of tokens) {
      if (titleText.includes(token)) score += 6;
      if (tagText.includes(token)) score += 4;
      if (descText.includes(token)) score += 2;
      if (bodyText.includes(token)) score += 1;
    }
    return score;
  };

  const detectHitZones = (doc, tokens) => {
    const zones = [];
    const titleText = normalize(doc.title ?? "");
    const descText = normalize(doc.description ?? "");
    const bodyText = normalize(doc.content ?? "");
    const tagText = normalize((doc.tags ?? []).join(" "));

    if (tokens.some((token) => titleText.includes(token))) zones.push(js.zoneTitle);
    if (tokens.some((token) => descText.includes(token))) zones.push(js.zoneDesc);
    if (tokens.some((token) => bodyText.includes(token))) zones.push(js.zoneBody);
    if (tokens.some((token) => tagText.includes(token))) zones.push(js.zoneTags);
    return zones;
  };

  const formatDate = (raw) => {
    if (!raw) return "";
    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat(js.dateLocale, {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(date);
  };

  const typeLabel = (type) => {
    if (type === "post") return js.typePost;
    if (type === "facebook_post") return js.typeFacebook;
    return js.typePage;
  };

  const typePriority = (type) => {
    if (type === "page") return 0;
    if (type === "post") return 1;
    if (type === "facebook_post") return 2;
    return 3;
  };

  const toTimestamp = (raw) => {
    if (!raw) return 0;
    const time = new Date(raw).getTime();
    return Number.isFinite(time) ? time : 0;
  };

  const resultCount = (n) => `${n}${js.resultsSuffix}`;

  const renderResults = (items, q) => {
    fallbackResults.innerHTML = "";
    const tokens = tokenize(q);

    if (!q) {
      setSearchState("idle");
      if (fallbackCount instanceof HTMLElement) {
        fallbackCount.textContent = "";
        fallbackCount.hidden = true;
      }
      return;
    }
    if (items.length === 0) {
      setSearchState("empty");
      fallbackResults.innerHTML = `<li class="search-result-item">${js.noResults}</li>`;
      if (fallbackCount instanceof HTMLElement) {
        fallbackCount.textContent = resultCount(0);
        fallbackCount.hidden = false;
      }
      return;
    }

    setSearchState("ready");
    if (fallbackCount instanceof HTMLElement) {
      fallbackCount.textContent = resultCount(items.length);
      fallbackCount.hidden = false;
    }

    for (const item of items) {
      const isContentDoc = item.type === "post" || item.type === "facebook_post";
      const dateLabel = isContentDoc ? formatDate(item.pubDate) : "";
      const topics = Array.isArray(item.topics) ? item.topics.slice(0, 3) : [];
      const tags = Array.isArray(item.tags)
        ? item.tags.filter((tag) => !topics.includes(tag)).slice(0, 4)
        : [];
      const hitZones = detectHitZones(item, tokens);
      const metaParts = [typeLabel(item.type), dateLabel].filter(Boolean);
      const li = document.createElement("li");
      li.className = "search-result-item";
      li.innerHTML = `
        <div class="search-result-top">
          <a class="search-result-link" href="${item.url}">${highlight(item.title, tokens)}</a>
          <span class="search-result-meta">${metaParts.join(" · ")}</span>
        </div>
        ${
          hitZones.length > 0
            ? `<p class="search-hit-zone">${js.hit}${hitZones.map((zone) => `<span>${zone}</span>`).join("")}</p>`
            : ""
        }
        <p class="search-result-snippet">${highlight(item.description ?? "", tokens)}</p>
        ${
          topics.length > 0 || tags.length > 0
            ? `<ul class="search-result-tags">
                ${topics.map((tag) => `<li class="search-result-tag-topic">${highlight(tag, tokens)}</li>`).join("")}
                ${tags.map((tag) => `<li class="search-result-tag-keyword">${highlight(tag, tokens)}</li>`).join("")}
              </ul>`
            : ""
        }
      `;
      fallbackResults.appendChild(li);
    }
  };

  const runFallbackSearch = async () => {
    setSearchState("loading");

    let docs = [];
    try {
      const res = await fetch(js.indexUrl, { headers: { accept: "application/json" } });
      if (!res.ok) throw new Error(`Load failed: ${res.status}`);
      docs = await res.json();
      setStatus("");
    } catch (error) {
      setSearchState("error");
      setStatus(js.loadFailed);
      console.error("[search] load index failed:", error);
      return;
    }

    const search = (q) => {
      const tokens = tokenize(q);
      if (tokens.length === 0) {
        renderResults([], "");
        if (fallbackCount) fallbackCount.textContent = js.idle;
        return;
      }

      const ranked = docs
        .map((doc) => ({ doc, score: scoreDoc(doc, tokens) }))
        .filter((item) => item.score > 0)
        .sort((a, b) => {
          const typeGap = typePriority(a.doc.type) - typePriority(b.doc.type);
          if (typeGap !== 0) return typeGap;
          if (b.score !== a.score) return b.score - a.score;
          return toTimestamp(b.doc.pubDate) - toTimestamp(a.doc.pubDate);
        })
        .slice(0, 100)
        .map((item) => item.doc);

      renderResults(ranked, q);
    };

    fallbackForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const q = fallbackInput?.value.trim() ?? "";
      track("Search Used", {
        mode: "json",
        query_length: String(q.length),
        scope: "all_content"
      });
      search(q);
    });

    fallbackInput?.addEventListener("input", () => {
      const q = fallbackInput.value.trim();
      search(q);
    });

    if (fallbackInput) {
      fallbackInput.value = query;
      fallbackInput.focus();
    }

    fallbackResults?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const link = target.closest(".search-result-link");
      if (!(link instanceof HTMLAnchorElement)) return;
      track("Search Result Click", { mode: "json" });
    });

    search(query);
  };

  runFallbackSearch();
</script>
