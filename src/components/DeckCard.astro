---
import { formatDate } from "@/utils/date";
import { withBase } from "@/utils/paths";
import type { ResolvedDeck } from "@/data/decks";

interface Props {
  deck: ResolvedDeck;
}

const { deck } = Astro.props as Props;

const isExternal = /^https?:\/\//.test(deck.url);
const href = isExternal ? deck.url : withBase(deck.url);
const dateLabel = formatDate(new Date(`${deck.date}T00:00:00`));
const langLabel = deck.lang === "en" ? "EN" : "中文";
---

<a class="deck-row" href={href} target="_blank" rel="noopener">
  <time class="deck-row-date" datetime={deck.date}>{dateLabel}</time>
  <span class="deck-row-body">
    <span class="deck-row-title">{deck.title}</span>
    <span class="deck-row-meta">
      {deck.event && <span class="deck-row-event">{deck.event}</span>}
      {deck.location && <span>{deck.location}</span>}
      <span class="deck-row-lang">{langLabel}</span>
    </span>
  </span>
  <span class="deck-row-arrow" aria-hidden="true">↗</span>
</a>

<style>
  .deck-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.1rem;
    background: var(--color-surface-elevated);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.16s ease,
      box-shadow 0.16s ease,
      background 0.16s ease;
  }
  .deck-row:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 7px 18px rgba(16, 48, 55, 0.08);
    background: var(--color-surface-muted);
  }
  .deck-row-date {
    flex: 0 0 auto;
    min-width: 6.5em;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .deck-row-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.28rem;
    min-width: 0;
  }
  .deck-row-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .deck-row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .deck-row-lang {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    padding: 0 0.5em;
    font-size: 0.78rem;
  }
  .deck-row-arrow {
    flex: 0 0 auto;
    align-self: center;
    color: var(--color-muted);
    transition: color 0.16s ease, transform 0.16s ease;
  }
  .deck-row:hover .deck-row-arrow {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }
  @media (max-width: 640px) {
    .deck-row {
      flex-direction: column;
      gap: 0.35rem;
      align-items: stretch;
    }
    .deck-row-date {
      min-width: 0;
      order: -1;
    }
    .deck-row-arrow {
      display: none;
    }
  }
</style>
