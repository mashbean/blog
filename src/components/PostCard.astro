---
import type { CollectionEntry } from "astro:content";
import { buildPostUrl } from "@/utils/blog";
import { formatDate } from "@/utils/date";
import { withBase } from "@/utils/paths";

interface Props {
  post: CollectionEntry<"blog">;
  variant?: "default" | "feature" | "compact";
}

const { post, variant = "default" } = Astro.props as Props;
const url = buildPostUrl(post);
const coverSrc = post.data.cover
  ? /^https?:\/\//.test(post.data.cover)
    ? post.data.cover
    : withBase(post.data.cover)
  : undefined;
const fallbackLabel = post.data.category ?? "文章";
---

<article class:list={{ "post-card": true, "post-card-feature": variant === "feature", "post-card-compact": variant === "compact" }}>
  <a class="post-card-thumb-link" href={url} aria-hidden="true" tabindex="-1">
    {post.data.cover ? (
      <img
        class="post-card-thumb"
        src={coverSrc}
        alt={post.data.coverAlt ?? post.data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="post-card-thumb post-card-thumb-fallback">
        <span>{fallbackLabel}</span>
        <small>{post.data.title}</small>
      </div>
    )}
  </a>
  <p class="post-card-meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    {post.data.category && <>{" · "}{post.data.category}</>}
    {
      post.data.updatedDate && (
        <>
          {" · 更新 "}
          <time datetime={post.data.updatedDate.toISOString()}>
            {formatDate(post.data.updatedDate)}
          </time>
        </>
      )
    }
  </p>
  <h2 class="post-card-title">
    <a href={url}>{post.data.title}</a>
  </h2>
  <p class="post-card-desc">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="tag-list" aria-label="文章標籤">
        {post.data.tags.map((tag) => <li class="tag-list-item">{tag}</li>)}
      </ul>
    )
  }
</article>
