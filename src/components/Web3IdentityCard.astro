---
type IdentityHandle = {
  label: string;
  value: string;
};

interface Props {
  name: string;
  avatarSrc: string;
  ens: string;
  handles: IdentityHandle[];
  graphHref: string;
  socialHubHref: string;
}

const { name, avatarSrc, ens, handles, graphHref, socialHubHref } = Astro.props;
---

<article class="web3-card" aria-label="web3 身分卡">
  <header class="web3-card-head">
    <img class="web3-card-avatar" src={avatarSrc} alt={`${name} avatar`} width="56" height="56" loading="lazy" />
    <div class="web3-card-head-copy">
      <p class="web3-card-kicker">web3 身分卡</p>
      <h3>{name}</h3>
      <p>{ens}</p>
    </div>
  </header>

  <ul class="web3-card-handle-list">
    {
      handles.map((item) => (
        <li>
          <span>{item.label}</span>
          <strong>{item.value}</strong>
        </li>
      ))
    }
  </ul>

  <div class="web3-card-actions">
    <a href={graphHref} target="_blank" rel="noopener noreferrer">
      鏈上社群圖譜
    </a>
    <a href={socialHubHref} target="_blank" rel="noopener noreferrer">
      跨平台入口
    </a>
  </div>
</article>
