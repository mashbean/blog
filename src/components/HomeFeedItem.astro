---
import type { HomeFeedItem } from "@/data/homeFeed";
import { formatDate } from "@/utils/date";

interface Props {
  item: HomeFeedItem;
}

const { item } = Astro.props as Props;
const imageErrorHandler = "this.closest('.home-feed-media')?.remove()";
const kindMark: Record<HomeFeedItem["kind"], string> = {
  article: "文",
  deck: "簡",
  work: "專",
  pro: "難",
};
---

<article class="home-feed-entry" data-kind={item.kind}>
  <a
    class:list={{ "home-feed-card": true, "home-feed-card-with-image": Boolean(item.image) }}
    href={item.url}
    target={item.external ? "_blank" : undefined}
    rel={item.external ? "noopener noreferrer" : undefined}
  >
    <header class="home-feed-header">
      <span class="home-feed-avatar" aria-hidden="true">{kindMark[item.kind]}</span>
      <div class="home-feed-byline">
        <p class="home-feed-meta">
          <strong class="home-feed-kind">{item.label}</strong>
          {item.detail && <span>{item.detail}</span>}
        </p>
        <p class="home-feed-date">
          <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
        </p>
      </div>
    </header>
    <div class="home-feed-copy">
      <h3 class="home-feed-title">
        {item.title}
        {
          item.external && (
            <span class="home-feed-arrow" aria-hidden="true">
              ↗
            </span>
          )
        }
      </h3>
      <p class="home-feed-summary">{item.summary}</p>
    </div>
    {
      item.image && (
        <figure class="home-feed-media">
          <img
            src={item.image}
            alt={item.imageAlt ?? ""}
            loading="lazy"
            decoding="async"
            onerror={imageErrorHandler}
          />
        </figure>
      )
    }
  </a>
</article>

<style>
  .home-feed-entry {
    min-width: 0;
  }

  .home-feed-card {
    display: block;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-left: 3px solid var(--feed-accent, var(--color-accent));
    border-radius: 0.72rem;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 1px 2px rgba(16, 48, 55, 0.05);
    text-decoration: none;
    transition:
      border-color 0.16s ease,
      box-shadow 0.16s ease,
      transform 0.16s ease;
  }

  .home-feed-card:hover {
    border-color: var(--feed-accent, var(--color-accent));
    box-shadow: 0 10px 24px rgba(16, 48, 55, 0.09);
    transform: translateY(-1px);
  }

  .home-feed-header {
    display: flex;
    align-items: center;
    gap: 0.62rem;
    padding: 0.78rem 0.9rem 0;
  }

  .home-feed-avatar {
    display: grid;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--feed-accent, var(--color-accent));
    font-size: 0.82rem;
    font-weight: 800;
  }

  .home-feed-byline {
    min-width: 0;
  }

  .home-feed-copy {
    min-width: 0;
    padding: 0.62rem 0.9rem 0.82rem;
  }

  .home-feed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.48rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .home-feed-kind {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    padding: 0.05rem 0.38rem;
    color: var(--feed-accent, var(--color-accent));
    background: var(--feed-soft, var(--color-accent-soft));
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .home-feed-date {
    margin: 0.12rem 0 0;
    color: var(--color-muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    line-height: 1.25;
  }

  .home-feed-title {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.45;
    transition: color 0.16s ease;
  }

  .home-feed-card:hover .home-feed-title {
    color: var(--feed-accent, var(--color-accent));
  }

  .home-feed-arrow {
    display: inline-block;
    margin-left: 0.2em;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.78em;
    transition: transform 0.16s ease;
  }

  .home-feed-card:hover .home-feed-arrow {
    transform: translate(2px, -2px);
  }

  .home-feed-summary {
    display: -webkit-box;
    margin: 0.42rem 0 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.58;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .home-feed-media {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-top: 1px solid var(--color-border-subtle);
    background: var(--feed-soft, var(--color-surface-muted));
  }

  .home-feed-media img {
    display: block;
    width: 100%;
    max-height: 9.25rem;
    aspect-ratio: 2.25 / 1;
    object-fit: cover;
    transition: transform 0.22s ease;
  }

  .home-feed-card:hover .home-feed-media img {
    transform: scale(1.025);
  }

  .home-feed-entry[data-kind="article"] {
    --feed-accent: #0b7d6d;
    --feed-soft: #e7f7f2;
  }

  .home-feed-entry[data-kind="deck"] {
    --feed-accent: #a45f16;
    --feed-soft: #fff3dc;
  }

  .home-feed-entry[data-kind="work"] {
    --feed-accent: #326b8a;
    --feed-soft: #e9f4fa;
  }

  .home-feed-entry[data-kind="pro"] {
    --feed-accent: #7b587d;
    --feed-soft: #f5ecf5;
  }

  .home-feed-entry[data-kind="pro"] .home-feed-media img {
    object-position: left center;
  }

  @media (max-width: 680px) {
    .home-feed-media img {
      max-height: 8.5rem;
      aspect-ratio: 2 / 1;
    }

    .home-feed-copy {
      padding: 0.6rem 0.82rem 0.78rem;
    }

    .home-feed-header {
      padding: 0.72rem 0.82rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-feed-card,
    .home-feed-media img,
    .home-feed-arrow {
      transition: none;
    }
  }
</style>
