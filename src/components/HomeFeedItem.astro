---
import type { HomeFeedItem } from "@/data/homeFeed";
import { formatDate } from "@/utils/date";

interface Props {
  item: HomeFeedItem;
}

const { item } = Astro.props as Props;
const imageErrorHandler =
  "this.closest('.home-feed-card')?.classList.remove('home-feed-card-with-image');this.closest('.home-feed-media')?.remove()";
const kindMark: Record<HomeFeedItem["kind"], string> = {
  article: "文",
  deck: "簡",
  work: "專",
  pro: "難",
};
---

<article class="home-feed-entry" data-kind={item.kind}>
  <a
    class:list={{ "home-feed-card": true, "home-feed-card-with-image": Boolean(item.image) }}
    href={item.url}
    target={item.external ? "_blank" : undefined}
    rel={item.external ? "noopener noreferrer" : undefined}
  >
    <header class="home-feed-header">
      <span class="home-feed-avatar" aria-hidden="true">{kindMark[item.kind]}</span>
      <p class="home-feed-meta">
        <strong class="home-feed-kind">{item.label}</strong>
        {item.detail && <span class="home-feed-detail">{item.detail}</span>}
        <span class="home-feed-separator" aria-hidden="true">·</span>
        <time class="home-feed-date" datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
      </p>
    </header>
    <div class="home-feed-body">
      <div class="home-feed-copy">
        <h3 class="home-feed-title">
          {item.title}
          {
            item.external && (
              <span class="home-feed-arrow" aria-hidden="true">
                ↗
              </span>
            )
          }
        </h3>
        <p class="home-feed-summary">{item.summary}</p>
      </div>
      {
        item.image && (
          <figure class="home-feed-media">
            <img
              src={item.image}
              alt={item.imageAlt ?? ""}
              loading="lazy"
              decoding="async"
              onerror={imageErrorHandler}
            />
          </figure>
        )
      }
    </div>
  </a>
</article>

<style>
  .home-feed-entry {
    min-width: 0;
  }

  .home-feed-card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.82rem;
    padding: 0.86rem 0.92rem 0.9rem 1.12rem;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 10px rgba(29, 55, 61, 0.045);
    text-decoration: none;
    transition:
      border-color 0.16s ease,
      box-shadow 0.16s ease,
      transform 0.16s ease;
  }

  .home-feed-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.27rem;
    background: var(--feed-accent, var(--color-accent));
  }

  .home-feed-card:hover {
    border-color: var(--feed-accent, var(--color-accent));
    box-shadow: 0 8px 22px rgba(29, 55, 61, 0.085);
    transform: translateY(-2px);
  }

  .home-feed-header {
    display: flex;
    align-items: center;
    gap: 0.48rem;
    min-width: 0;
    margin-bottom: 0.58rem;
  }

  .home-feed-avatar {
    display: grid;
    flex: 0 0 auto;
    width: 1.62rem;
    height: 1.62rem;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--feed-accent) 28%, white 72%);
    border-radius: 0.42rem;
    color: var(--feed-accent, var(--color-accent));
    background: var(--feed-soft, var(--color-accent-soft));
    font-size: 0.7rem;
    font-weight: 800;
  }

  .home-feed-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    min-width: 0;
    align-items: center;
  }

  .home-feed-card-with-image .home-feed-body {
    grid-template-columns: minmax(0, 1fr) 9.4rem;
  }

  .home-feed-copy {
    min-width: 0;
  }

  .home-feed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.18rem 0.38rem;
    min-width: 0;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .home-feed-kind {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    padding: 0.08rem 0.42rem;
    color: #fff;
    background: var(--feed-accent, var(--color-accent));
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .home-feed-detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-feed-separator {
    color: var(--color-border-strong);
  }

  .home-feed-date {
    flex: 0 0 auto;
    color: color-mix(in oklab, var(--color-muted) 84%, white 16%);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
  }

  .home-feed-title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.48;
    font-weight: 650;
    transition: color 0.16s ease;
  }

  .home-feed-card:hover .home-feed-title {
    color: var(--feed-accent, var(--color-accent));
  }

  .home-feed-arrow {
    display: inline-block;
    margin-left: 0.2em;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.78em;
    transition: transform 0.16s ease;
  }

  .home-feed-card:hover .home-feed-arrow {
    transform: translate(2px, -2px);
  }

  .home-feed-summary {
    display: -webkit-box;
    margin: 0.34rem 0 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .home-feed-media {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.56rem;
    background: var(--feed-soft, var(--color-surface-muted));
  }

  .home-feed-media img {
    display: block;
    width: 100%;
    height: 6.15rem;
    object-fit: cover;
    transition: transform 0.22s ease;
  }

  .home-feed-card:hover .home-feed-media img {
    transform: scale(1.025);
  }

  .home-feed-entry[data-kind="article"] {
    --feed-accent: #0b7d6d;
    --feed-soft: #e7f7f2;
  }

  .home-feed-entry[data-kind="deck"] {
    --feed-accent: #a45f16;
    --feed-soft: #fff3dc;
  }

  .home-feed-entry[data-kind="work"] {
    --feed-accent: #326b8a;
    --feed-soft: #e9f4fa;
  }

  .home-feed-entry[data-kind="pro"] {
    --feed-accent: #7b587d;
    --feed-soft: #f5ecf5;
  }

  .home-feed-entry[data-kind="pro"] .home-feed-media img {
    object-position: left center;
  }

  @media (max-width: 680px) {
    .home-feed-card {
      padding: 0.76rem 0.75rem 0.78rem 0.94rem;
    }

    .home-feed-card-with-image .home-feed-body {
      grid-template-columns: minmax(0, 1fr) 5.75rem;
      gap: 0.68rem;
    }

    .home-feed-media img {
      height: 4.6rem;
    }

    .home-feed-header {
      margin-bottom: 0.5rem;
    }

    .home-feed-summary {
      -webkit-line-clamp: 2;
    }

    .home-feed-detail {
      max-width: 9rem;
    }
  }

  @media (max-width: 390px) {
    .home-feed-title {
      font-size: 0.96rem;
    }

    .home-feed-summary {
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-feed-card,
    .home-feed-media img,
    .home-feed-arrow {
      transition: none;
    }
  }
</style>
