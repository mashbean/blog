---
import type { HomeFeedItem } from "@/data/homeFeed";
import { formatDate } from "@/utils/date";

interface Props {
  item: HomeFeedItem;
}

const { item } = Astro.props as Props;
const imageErrorHandler = "this.closest('.home-feed-media')?.remove()";
---

<article class="home-feed-entry" data-kind={item.kind}>
  <p class="home-feed-date">
    <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
  </p>
  <span class="home-feed-dot" aria-hidden="true"></span>
  <a
    class:list={{ "home-feed-card": true, "home-feed-card-with-image": Boolean(item.image) }}
    href={item.url}
    target={item.external ? "_blank" : undefined}
    rel={item.external ? "noopener noreferrer" : undefined}
  >
    <div class="home-feed-copy">
      <p class="home-feed-meta">
        <span class="home-feed-kind">{item.label}</span>
        {item.detail && <span>{item.detail}</span>}
      </p>
      <h3 class="home-feed-title">
        {item.title}
        {
          item.external && (
            <span class="home-feed-arrow" aria-hidden="true">
              ↗
            </span>
          )
        }
      </h3>
      <p class="home-feed-summary">{item.summary}</p>
    </div>
    {
      item.image && (
        <figure class="home-feed-media">
          <img
            src={item.image}
            alt={item.imageAlt ?? ""}
            loading="lazy"
            decoding="async"
            onerror={imageErrorHandler}
          />
        </figure>
      )
    }
  </a>
</article>

<style>
  .home-feed-entry {
    display: grid;
    grid-template-columns: 6.4rem 1.1rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    min-width: 0;
  }

  .home-feed-date {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.76rem;
    line-height: 1.3;
    text-align: right;
  }

  .home-feed-dot {
    position: relative;
    z-index: 1;
    width: 0.72rem;
    height: 0.72rem;
    margin: 1.08rem auto 0;
    border: 2px solid var(--feed-accent, var(--color-accent));
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 0 0 0.25rem var(--color-paper);
  }

  .home-feed-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.95rem;
    color: var(--color-ink);
    background: color-mix(in oklab, #ffffff 96%, var(--feed-soft, #eef9f5) 4%);
    text-decoration: none;
    transition:
      border-color 0.16s ease,
      box-shadow 0.16s ease,
      transform 0.16s ease;
  }

  .home-feed-card-with-image {
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 14rem);
  }

  .home-feed-card:hover {
    border-color: var(--feed-accent, var(--color-accent));
    box-shadow: 0 10px 24px rgba(16, 48, 55, 0.09);
    transform: translateY(-1px);
  }

  .home-feed-copy {
    min-width: 0;
    padding: 0.88rem 1rem 0.92rem;
  }

  .home-feed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.62rem;
    margin: 0 0 0.34rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .home-feed-kind {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in oklab, var(--feed-accent, var(--color-accent)) 45%, white 55%);
    border-radius: var(--radius-pill);
    padding: 0.06rem 0.5rem;
    color: var(--feed-accent, var(--color-accent));
    background: var(--feed-soft, var(--color-accent-soft));
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .home-feed-title {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.28rem);
    line-height: 1.38;
    transition: color 0.16s ease;
  }

  .home-feed-card:hover .home-feed-title {
    color: var(--feed-accent, var(--color-accent));
  }

  .home-feed-arrow {
    display: inline-block;
    margin-left: 0.2em;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.78em;
    transition: transform 0.16s ease;
  }

  .home-feed-card:hover .home-feed-arrow {
    transform: translate(2px, -2px);
  }

  .home-feed-summary {
    display: -webkit-box;
    margin: 0.42rem 0 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.62;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .home-feed-media {
    min-width: 0;
    height: 100%;
    min-height: 8.35rem;
    margin: 0;
    overflow: hidden;
    border-left: 1px solid var(--color-border-subtle);
    background: var(--feed-soft, var(--color-surface-muted));
  }

  .home-feed-media img {
    width: 100%;
    height: 100%;
    min-height: 8.35rem;
    object-fit: cover;
    transition: transform 0.22s ease;
  }

  .home-feed-card:hover .home-feed-media img {
    transform: scale(1.025);
  }

  .home-feed-entry[data-kind="article"] {
    --feed-accent: #0b7d6d;
    --feed-soft: #e7f7f2;
  }

  .home-feed-entry[data-kind="deck"] {
    --feed-accent: #a45f16;
    --feed-soft: #fff3dc;
  }

  .home-feed-entry[data-kind="work"] {
    --feed-accent: #326b8a;
    --feed-soft: #e9f4fa;
  }

  .home-feed-entry[data-kind="pro"] {
    --feed-accent: #7b587d;
    --feed-soft: #f5ecf5;
  }

  .home-feed-entry[data-kind="pro"] .home-feed-media img {
    object-position: left center;
  }

  @media (max-width: 680px) {
    .home-feed-entry {
      grid-template-columns: 0.95rem minmax(0, 1fr);
      gap: 0.34rem 0.76rem;
    }

    .home-feed-date {
      grid-column: 2;
      grid-row: 1;
      margin: 0;
      text-align: left;
    }

    .home-feed-dot {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-top: 0.16rem;
    }

    .home-feed-card {
      grid-column: 2;
      grid-row: 2;
    }

    .home-feed-card-with-image {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-feed-media {
      grid-row: 1;
      height: auto;
      min-height: 0;
      border-left: 0;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .home-feed-media img {
      min-height: 0;
      aspect-ratio: 2.15 / 1;
    }

    .home-feed-copy {
      padding: 0.78rem 0.85rem 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-feed-card,
    .home-feed-media img,
    .home-feed-arrow {
      transition: none;
    }
  }
</style>
