---
import type { HomeFeedItem } from "@/data/homeFeed";
import { formatDate } from "@/utils/date";

interface Props {
  item: HomeFeedItem;
}

const { item } = Astro.props as Props;
const imageErrorHandler =
  "this.closest('.home-feed-card')?.classList.remove('home-feed-card-with-image');this.closest('.home-feed-media')?.remove()";
---

<article class="home-feed-entry" data-kind={item.kind}>
  <a
    class:list={{ "home-feed-card": true, "home-feed-card-with-image": Boolean(item.image) }}
    href={item.url}
    target={item.external ? "_blank" : undefined}
    rel={item.external ? "noopener noreferrer" : undefined}
  >
    <header class="home-feed-header">
      <p class="home-feed-meta">
        <time class="home-feed-date" datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
        <span class="home-feed-separator" aria-hidden="true">·</span>
        <strong class="home-feed-kind">{item.label}</strong>
        {item.detail && <span class="home-feed-detail">{item.detail}</span>}
      </p>
    </header>
    <div class="home-feed-body">
      <div class="home-feed-copy">
        <h3 class="home-feed-title">
          {item.title}
          {
            item.external && (
              <span class="home-feed-arrow" aria-hidden="true">
                ↗
              </span>
            )
          }
        </h3>
        <p class="home-feed-summary">{item.summary}</p>
      </div>
      {
        item.image && (
          <figure class="home-feed-media">
            <img
              src={item.image}
              alt={item.imageAlt ?? ""}
              loading="lazy"
              decoding="async"
              onerror={imageErrorHandler}
            />
          </figure>
        )
      }
    </div>
  </a>
</article>

<style>
  .home-feed-entry {
    position: relative;
    min-width: 0;
  }

  .home-feed-entry::before {
    content: "";
    position: absolute;
    z-index: 2;
    top: 1.14rem;
    left: -1.48rem;
    width: 0.72rem;
    height: 0.72rem;
    border: 2px solid var(--feed-accent, var(--color-accent));
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 0 0 0.25rem var(--color-paper);
  }

  .home-feed-card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border: 1px solid
      color-mix(
        in oklab,
        var(--feed-accent, var(--color-accent)) 10%,
        var(--color-border-subtle)
      );
    border-radius: 0.82rem;
    padding: 0.88rem 0.94rem 0.92rem;
    color: var(--color-ink);
    background: color-mix(in oklab, var(--feed-soft, var(--color-surface-muted)) 68%, white 32%);
    box-shadow: 0 2px 9px rgba(29, 55, 61, 0.04);
    text-decoration: none;
    transition:
      border-color 0.16s ease,
      background-color 0.16s ease,
      box-shadow 0.16s ease,
      transform 0.16s ease;
  }

  .home-feed-card:hover {
    border-color: color-mix(
      in oklab,
      var(--feed-accent, var(--color-accent)) 24%,
      var(--color-border-subtle)
    );
    background: color-mix(in oklab, var(--feed-soft, var(--color-surface-muted)) 82%, white 18%);
    box-shadow: 0 6px 18px rgba(29, 55, 61, 0.075);
    transform: translateY(-1px);
  }

  .home-feed-card:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--feed-accent, var(--color-accent)) 52%, white);
    outline-offset: 2px;
  }

  .home-feed-header {
    display: flex;
    align-items: center;
    min-width: 0;
    margin-bottom: 0.48rem;
  }

  .home-feed-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.86rem;
    min-width: 0;
    align-items: start;
  }

  .home-feed-card-with-image .home-feed-body {
    grid-template-columns: minmax(0, 1fr) 8.5rem;
  }

  .home-feed-copy {
    min-width: 0;
  }

  .home-feed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.12rem 0.34rem;
    min-width: 0;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .home-feed-kind {
    display: inline-flex;
    align-items: center;
    color: color-mix(in oklab, var(--feed-accent, var(--color-accent)) 74%, var(--color-muted));
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .home-feed-detail {
    overflow: hidden;
    color: color-mix(in oklab, var(--color-muted) 82%, white);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-feed-detail::before {
    content: "/";
    margin-right: 0.34rem;
    color: var(--color-border-strong);
  }

  .home-feed-separator {
    color: var(--color-border-strong);
  }

  .home-feed-date {
    flex: 0 0 auto;
    color: color-mix(in oklab, var(--feed-accent, var(--color-accent)) 76%, var(--color-ink));
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .home-feed-title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 650;
    transition: color 0.16s ease;
  }

  .home-feed-card:hover .home-feed-title {
    color: var(--feed-accent, var(--color-accent));
  }

  .home-feed-arrow {
    display: inline-block;
    margin-left: 0.2em;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.78em;
    transition: transform 0.16s ease;
  }

  .home-feed-card:hover .home-feed-arrow {
    transform: translate(2px, -2px);
  }

  .home-feed-summary {
    display: -webkit-box;
    margin: 0.3rem 0 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.58;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .home-feed-media {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.56rem;
    background: var(--feed-soft, var(--color-surface-muted));
  }

  .home-feed-media img {
    display: block;
    width: 100%;
    height: 5.35rem;
    object-fit: cover;
  }

  .home-feed-entry[data-kind="article"] {
    --feed-accent: #0b7d6d;
    --feed-soft: #e7f7f2;
  }

  .home-feed-entry[data-kind="deck"] {
    --feed-accent: #a45f16;
    --feed-soft: #fff3dc;
  }

  .home-feed-entry[data-kind="work"] {
    --feed-accent: #326b8a;
    --feed-soft: #e9f4fa;
  }

  .home-feed-entry[data-kind="pro"] {
    --feed-accent: #7b587d;
    --feed-soft: #f5ecf5;
  }

  .home-feed-entry[data-kind="pro"] .home-feed-media img {
    object-position: left center;
  }

  @media (max-width: 680px) {
    .home-feed-card {
      padding: 0.76rem 0.78rem 0.8rem;
    }

    .home-feed-card-with-image .home-feed-body {
      grid-template-columns: minmax(0, 1fr) 5.4rem;
      gap: 0.64rem;
    }

    .home-feed-media img {
      height: 4.25rem;
    }

    .home-feed-header {
      margin-bottom: 0.5rem;
    }

    .home-feed-entry::before {
      top: 1.02rem;
    }

    .home-feed-summary {
      -webkit-line-clamp: 2;
    }

    .home-feed-detail {
      max-width: 9rem;
    }
  }

  @media (max-width: 390px) {
    .home-feed-title {
      font-size: 0.96rem;
    }

    .home-feed-summary {
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-feed-card,
    .home-feed-arrow {
      transition: none;
    }
  }
</style>
