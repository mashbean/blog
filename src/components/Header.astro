---
import { SITE_TITLE } from "@/site.config";
import { withBase } from "@/utils/paths";
import Web3IdentityCard from "@/components/Web3IdentityCard.astro";

const pathname = Astro.url.pathname;
const links = [
  { href: withBase(""), label: "首頁" },
  { href: withBase("blog/"), label: "文章" },
  { href: withBase("tags/"), label: "標籤" },
  { href: withBase("search/"), label: "搜尋" },
  { href: withBase("about/"), label: "關於" }
];
const socialLinks = [
  {
    href: "https://www.facebook.com/mashbean",
    label: "Facebook",
    note: "長文與廢文",
    iconPath:
      "M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.88 3.78-3.88 1.1 0 2.25.2 2.25.2v2.46H15.2c-1.25 0-1.64.78-1.64 1.57V12h2.8l-.45 2.89h-2.35v6.99A10 10 0 0 0 22 12z"
  },
  {
    href: "mailto:mashbean@gmail.com",
    label: "Email",
    note: "工作會回信",
    iconPath: "M2 5h20v14H2zm10 7L4 7v10h16V7z"
  },
  {
    href: "https://x.com/mashbean",
    label: "Twitter/X",
    note: "web3 回覆",
    iconPath:
      "M18.9 2H22l-6.78 7.75L23 22h-6.1l-4.77-6.22L6.68 22H3.56l7.25-8.29L2 2h6.25l4.3 5.68L18.9 2zm-1.07 18h1.69L7.33 3.9H5.51z"
  },
  {
    href: "https://www.linkedin.com/in/mashbean/",
    label: "LinkedIn",
    note: "穿西裝",
    iconPath:
      "M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.95v5.67H9.33V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77A1.77 1.77 0 0 0 0 1.77v20.46C0 23.2.8 24 1.77 24h20.46A1.77 1.77 0 0 0 24 22.23V1.77A1.77 1.77 0 0 0 22.23 0z"
  },
  {
    href: "https://matters.town/@mashbean",
    label: "Matters",
    note: "認真收長文",
    iconPath: "M3 5h3.2l3.8 6.7L13.8 5H17v14h-3V11l-3.2 5.6h-1.6L6 11v8H3z"
  }
];
const identityLinks = [
  {
    href: "https://web3.bio/mashbean.eth",
    label: "ENS",
    value: "mashbean.eth",
    iconPath: "M12 1 3 6v12l9 5 9-5V6Zm0 2.2L18.8 7 12 10.8 5.2 7Zm-7 5.3 6 3.4v7L5 15.5Zm14 0v7L13 18.9v-7Z"
  },
  {
    href: "https://hey.xyz/u/mashbean",
    label: "Lens",
    value: "@mashbean",
    iconPath:
      "M3 4.5A1.5 1.5 0 0 1 4.5 3H11v7.5H3zm10 0A1.5 1.5 0 0 1 14.5 3H21v7.5h-8zM3 12.5h8V21H4.5A1.5 1.5 0 0 1 3 19.5zm10 0h8v7A1.5 1.5 0 0 1 19.5 21H13z"
  },
  {
    href: "https://bsky.app/profile/mashbean.bsky.social",
    label: "Bluesky",
    value: "@mashbean.bsky.social",
    iconPath:
      "M12 11.9c1.6-3.1 4.1-5.8 7.2-7.8 1.2-.8 3.2-1.4 3.2.8 0 .4-.2 3.8-.3 4.2-.5 1.4-2.1 1.8-3.6 1.6 2.6.4 3.3 1.8 1.9 3.3-2.8 3-4 1-4.4.1-.1-.3-.2-.5-.3-.8-.1.3-.2.5-.3.8-.4.9-1.6 2.9-4.4-.1-1.4-1.5-.7-2.9 1.9-3.3-1.5.2-3.1-.2-3.6-1.6-.1-.4-.3-3.8-.3-4.2 0-2.2 2-1.6 3.2-.8 3.1 2 5.6 4.7 7.2 7.8z"
  },
  {
    href: "https://www.threads.net/@mashbean",
    label: "Threads",
    value: "@mashbean",
    iconPath:
      "M16.2 11.5c-.3-2.8-2.1-4.3-4.9-4.3-3.2 0-5.2 2-5.2 4.9 0 3.1 2.2 5 5.5 5 2.6 0 4.4-1.2 4.9-3.3h-2.3c-.4 1-1.4 1.6-2.7 1.6-1.8 0-2.9-1-3-2.7h7.7c.1-.3.1-.7 0-1.2zm-7.6-.6c.2-1.3 1.2-2.1 2.6-2.1 1.3 0 2.2.7 2.4 2.1zM12 1.5A10.5 10.5 0 1 0 22.5 12 10.5 10.5 0 0 0 12 1.5z"
  }
];
const subscribeLinks = [
  { href: withBase("subscribe/"), label: "RSS 訂閱" }
];
const web3Card = {
  name: "mashbean",
  avatarSrc: withBase("images/favicon-512.png"),
  ens: "mashbean.eth",
  handles: [
    { label: "Lens", value: "@mashbean" },
    { label: "Bluesky", value: "@mashbean.bsky.social" },
    { label: "Threads", value: "@mashbean" }
  ],
  graphHref: "https://web3.bio/mashbean.eth",
  socialHubHref: "https://firefly.social/"
};

const isActive = (href: string): boolean => {
  return pathname === href || (href !== withBase("") && pathname.startsWith(href));
};
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand-link" href={withBase("")}>{SITE_TITLE}</a>
    <div class="nav-social-item">
      <button
        type="button"
        class="nav-social-toggle"
        aria-expanded="false"
        aria-controls="header-social-drawer"
      >
        加我好友
      </button>
      <div class="nav-social-backdrop" hidden></div>
      <div id="header-social-drawer" class="nav-social-drawer" hidden>
        <div class="nav-social-drawer-head">
          <p>加我好友</p>
          <button type="button" class="nav-social-close" aria-label="關閉抽屜">
            關閉
          </button>
        </div>
        <Web3IdentityCard
          name={web3Card.name}
          avatarSrc={web3Card.avatarSrc}
          ens={web3Card.ens}
          handles={web3Card.handles}
          graphHref={web3Card.graphHref}
          socialHubHref={web3Card.socialHubHref}
        />
        <section class="nav-social-section" aria-label="社群平台">
          <h3 class="nav-social-title">社群平台</h3>
          <ul class="nav-social-list">
            {
              socialLinks.map((item) => {
                const isMailto = item.href.startsWith("mailto:");
                return (
                  <li>
                    <a
                      href={item.href}
                      target={isMailto ? undefined : "_blank"}
                      rel={isMailto ? undefined : "noopener noreferrer"}
                      class="nav-social-link nav-social-link-with-note"
                    >
                      <span class="nav-social-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d={item.iconPath} />
                        </svg>
                      </span>
                      <span class="nav-social-link-copy">
                        <strong>{item.label}</strong>
                      </span>
                      <small class="nav-social-link-note">{item.note}</small>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>
        <section class="nav-social-section" aria-label="Web3 身分">
          <h3 class="nav-social-title">Web3 身分</h3>
          <ul class="nav-social-list">
            {
              identityLinks.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener noreferrer" class="nav-social-link">
                    <span class="nav-social-link-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d={item.iconPath} />
                      </svg>
                    </span>
                    <span class="nav-social-link-copy">
                      <strong>{item.label}</strong>
                      <small>{item.value}</small>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="nav-social-section" aria-label="訂閱">
          <h3 class="nav-social-title">訂閱</h3>
          <ul class="nav-social-list nav-social-list-compact">
            {
              subscribeLinks.map((item) => (
                <li>
                  <a href={item.href} class="nav-social-link nav-social-link-compact">
                    <span class="nav-social-link-copy">
                      <strong>{item.label}</strong>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
    <nav class="site-nav" aria-label="主選單">
      <ul class="nav-list">
        {
          links.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{
                  "nav-link": true,
                  "nav-link-active": isActive(item.href)
                }}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  const mq = window.matchMedia("(max-width: 760px)");
  const toggle = document.querySelector(".nav-social-toggle");
  const closeBtn = document.querySelector(".nav-social-close");
  const backdrop = document.querySelector(".nav-social-backdrop");
  const drawer = document.querySelector("#header-social-drawer");

  if (
    toggle instanceof HTMLButtonElement &&
    backdrop instanceof HTMLElement &&
    drawer instanceof HTMLElement
  ) {
    const setOpen = (isOpen) => {
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      drawer.hidden = !isOpen;
      backdrop.hidden = !isOpen || !mq.matches;
      document.body.classList.toggle("nav-drawer-open", isOpen && mq.matches);
    };

    const closeDrawer = () => {
      setOpen(false);
    };

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!expanded);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (mq.matches) return;
      if (toggle.contains(target) || drawer.contains(target)) return;
      closeDrawer();
    });

    backdrop.addEventListener("click", closeDrawer);
    closeBtn?.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeDrawer();
    });

    mq.addEventListener("change", closeDrawer);
    closeDrawer();
  }
</script>
