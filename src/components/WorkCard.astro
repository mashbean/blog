---
import { withBase } from "@/utils/paths";
import type { Work } from "@/data/works";

interface Props {
  work: Work;
}

const { work } = Astro.props as Props;
---

<article class="work-card" id={work.slug}>
  {
    work.cover && (
      <a
        class="work-card-cover"
        href={work.url}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
      >
        <img src={withBase(work.cover)} alt="" loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="work-card-body">
    <h3 class="work-card-title">
      <a href={work.url} target="_blank" rel="noopener noreferrer">
        {work.title}
        <span class="work-card-arrow" aria-hidden="true">↗</span>
      </a>
    </h3>
    <p class="work-card-tagline">{work.tagline}</p>
    <p class="work-card-meta">
      {work.chips?.map((chip) => <span class="work-card-chip">{chip}</span>)}
      {work.note && <span class="work-card-note">{work.note}</span>}
      {
        work.repo && (
          <a class="work-card-repo" href={work.repo} target="_blank" rel="noopener noreferrer">
            原始碼
          </a>
        )
      }
    </p>
  </div>
</article>

<style>
  .work-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface-elevated);
    overflow: hidden;
    transition:
      border-color 0.16s ease,
      box-shadow 0.16s ease,
      background 0.16s ease;
  }
  .work-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 7px 18px rgba(16, 48, 55, 0.08);
    background: var(--color-surface-muted);
  }
  .work-card-cover {
    display: block;
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-surface-muted);
  }
  .work-card-cover img {
    width: 100%;
    aspect-ratio: 40 / 21;
    object-fit: cover;
    display: block;
    transition: transform 0.22s ease;
  }
  .work-card:hover .work-card-cover img {
    transform: scale(1.02);
  }
  .work-card-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.85rem 1.1rem 0.85rem;
  }
  .work-card-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.16rem;
    line-height: 1.35;
  }
  .work-card-title a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .work-card-title a:hover {
    color: var(--color-accent);
  }
  .work-card-arrow {
    display: inline-block;
    margin-left: 0.15em;
    color: var(--color-muted);
    font-size: 0.85em;
    transition: color 0.16s ease, transform 0.16s ease;
  }
  .work-card:hover .work-card-arrow {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }
  .work-card-tagline {
    margin: 0;
    flex: 1 1 auto;
    color: var(--color-ink);
    font-size: 0.95rem;
    line-height: 1.72;
  }
  .work-card-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  .work-card-chip {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    padding: 0.05em 0.6em;
    background: var(--color-surface-muted);
  }
  .work-card-note {
    color: #8a6d1f;
  }
  .work-card-repo {
    margin-left: auto;
    color: var(--color-muted);
  }
  .work-card-repo:hover {
    color: var(--color-accent);
  }
</style>
