---
import { ethers } from "ethers";
import type { EnsResolution } from "@/utils/ens";

interface Props {
  ensName: string;
  chainId: number;
  ens: EnsResolution;
}

const { ensName, chainId, ens } = Astro.props;

const tipAddress = ens.resolvedAddress ?? ensName;
const tipAmountNtd = 100;
const fallbackTipAmountEth = 0.001;
const rateApiUrl = "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=twd";

const formatEthAmount = (value: number): string => {
  const fixed = value.toFixed(8);
  return fixed.replace(/0+$/, "").replace(/\.$/, "");
};

const fetchEthTwdRate = async (): Promise<number | null> => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 3500);

  try {
    const response = await fetch(rateApiUrl, {
      headers: { accept: "application/json" },
      signal: controller.signal
    });
    if (!response.ok) return null;
    const payload = await response.json();
    const rate = Number(payload?.ethereum?.twd);
    if (!Number.isFinite(rate) || rate <= 0) return null;
    return rate;
  } catch {
    return null;
  } finally {
    clearTimeout(timeout);
  }
};

const ethTwdRate = await fetchEthTwdRate();
const tipAmountEthValue = ethTwdRate ? tipAmountNtd / ethTwdRate : fallbackTipAmountEth;
const tipAmountEth = formatEthAmount(tipAmountEthValue);
const tipRateNote = ethTwdRate
  ? `依即時匯率估算（1 ETH ≈ NT$${Math.round(ethTwdRate).toLocaleString("zh-TW")}）`
  : "匯率服務暫時不可用，已使用預設金額";

const toEip681 = (valueEth: string): string => {
  const valueWei = ethers.utils.parseEther(valueEth).toString();
  return `ethereum:${tipAddress}@${chainId}?value=${valueWei}`;
};

const primaryPaymentURI = toEip681(tipAmountEth);
const qrUrl = `https://quickchart.io/qr?text=${encodeURIComponent(primaryPaymentURI)}&size=240`;
---

<details class="tip-jar-disclosure">
  <summary class="tip-jar-summary">
    <span class="toc-share-btn tip-jar-toggle">抖內抖泥</span>
  </summary>
  <section class="tip-jar" aria-label="打賞">
    <p class="tip-jar-line">
      <span class="tip-ens-label">ENS</span>
      <code class="tip-ens-name">{ensName}</code>
      {
        ens.isVerified ? (
          <span class="tip-verified">已驗證</span>
        ) : (
          <span class="tip-warning">未驗證</span>
        )
      }
    </p>
    <p class="tip-jar-line tip-subtle">{tipRateNote}</p>
    {
      ens.error && (
        <p class="tip-jar-line tip-warning">ENS 解析異常：{ens.error}</p>
      )
    }

    <div class="tip-actions">
      <a class="tip-pay-link" href={primaryPaymentURI}>
        打賞 {tipAmountEth} ETH（約 NT${tipAmountNtd}）
      </a>
      <button
        type="button"
        class="tip-qr-btn"
        data-tip-qr-toggle
        aria-controls="tip-qr-panel"
        aria-expanded="false"
      >
        掃碼抖內
      </button>
    </div>

    <div class="tip-qr-panel" id="tip-qr-panel" hidden>
      <a class="tip-qr-link" href={primaryPaymentURI} aria-label="打開錢包付款請求">
        <img src={qrUrl} alt="打賞付款 QR code" width="180" height="180" loading="lazy" decoding="async" />
      </a>
    </div>
  </section>
</details>

<script is:inline>
  const tipRoot = document.currentScript?.previousElementSibling;
  const qrToggleBtn = tipRoot?.querySelector("[data-tip-qr-toggle]");
  const qrPanel = tipRoot?.querySelector("#tip-qr-panel");
  qrToggleBtn?.addEventListener("click", () => {
    if (!(qrToggleBtn instanceof HTMLButtonElement) || !(qrPanel instanceof HTMLElement)) return;
    const isOpen = qrToggleBtn.getAttribute("aria-expanded") === "true";
    qrToggleBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
    qrToggleBtn.textContent = isOpen ? "掃碼抖內" : "收起掃碼";
    qrPanel.hidden = isOpen;
  });
</script>

<style>
  .tip-jar-disclosure {
    margin-top: 0.72rem;
  }

  .tip-jar-summary {
    list-style: none;
    cursor: pointer;
  }

  .tip-jar-summary::-webkit-details-marker {
    display: none;
  }

  .tip-jar-toggle {
    width: 100%;
    justify-content: center;
  }

  .tip-jar-disclosure[open] .tip-jar-toggle {
    background: #ebf6f2;
    border-color: #a7cdc3;
  }

  .tip-jar {
    margin-top: 0.6rem;
    border: 1px solid #c8d9d3;
    border-radius: 0.9rem;
    background: #f5fbf9;
    padding: 0.84rem;
  }

  .tip-jar-line {
    margin: 0;
    font-size: 0.88rem;
    color: #2b3f48;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.38rem;
  }

  .tip-subtle {
    margin-top: 0.5rem;
    color: #4b6470;
    font-size: 0.8rem;
  }

  .tip-ens-label {
    display: inline-flex;
    align-items: center;
    border: 1px solid #c8ddd7;
    border-radius: 999px;
    background: #eef9f5;
    color: #2f5963;
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.18rem 0.44rem;
  }

  .tip-ens-name {
    border: 1px solid #d1e3de;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #173744;
    font-size: 0.82rem;
    line-height: 1;
    padding: 0.22rem 0.42rem;
  }

  .tip-verified,
  .tip-warning {
    margin-left: 0;
    font-size: 0.72rem;
    padding: 0.08rem 0.42rem;
    border-radius: 999px;
    border: 1px solid transparent;
  }

  .tip-verified {
    color: #0d5d51;
    background: #d7f2ec;
    border-color: #9fddd1;
  }

  .tip-warning {
    color: #9a5600;
    background: #fff3de;
    border-color: #e9c78f;
  }

  .tip-actions {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.72rem;
  }

  .tip-pay-link,
  .tip-qr-btn {
    border: 1px solid #c7d8d2;
    border-radius: 0.62rem;
    padding: 0.36rem 0.68rem;
    background: #ffffff;
    color: #2f5664;
    text-decoration: none;
    font-size: 0.82rem;
    cursor: pointer;
    text-align: center;
    min-height: 2.1rem;
  }

  .tip-pay-link:hover,
  .tip-qr-btn:hover {
    color: #0b7d6d;
    border-color: #98d4c8;
    background: #eef8f4;
  }

  .tip-qr-panel {
    margin-top: 0.72rem;
  }

  .tip-qr-link {
    display: inline-block;
    border: 1px solid #d1dfdb;
    border-radius: 0.8rem;
    padding: 0.45rem;
    background: #fff;
  }
</style>
