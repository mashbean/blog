---
import { ethers } from "ethers";
import type { EnsResolution } from "@/utils/ens";

interface Props {
  ensName: string;
  chainId: number;
  ens: EnsResolution;
}

const { ensName, chainId, ens } = Astro.props;

const tipAddress = ens.resolvedAddress ?? ensName;
const tipAmountNtd = 100;
const fallbackTipAmountEth = 0.001;
const rateApiUrl = "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=twd";

const formatEthAmount = (value: number): string => {
  const fixed = value.toFixed(8);
  return fixed.replace(/0+$/, "").replace(/\.$/, "");
};

const fetchEthTwdRate = async (): Promise<number | null> => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 3500);

  try {
    const response = await fetch(rateApiUrl, {
      headers: { accept: "application/json" },
      signal: controller.signal
    });
    if (!response.ok) return null;
    const payload = await response.json();
    const rate = Number(payload?.ethereum?.twd);
    if (!Number.isFinite(rate) || rate <= 0) return null;
    return rate;
  } catch {
    return null;
  } finally {
    clearTimeout(timeout);
  }
};

const ethTwdRate = await fetchEthTwdRate();
const tipAmountEthValue = ethTwdRate ? tipAmountNtd / ethTwdRate : fallbackTipAmountEth;
const tipAmountEth = formatEthAmount(tipAmountEthValue);

const toEip681 = (valueEth: string): string => {
  const valueWei = ethers.utils.parseEther(valueEth).toString();
  return `ethereum:${tipAddress}@${chainId}?value=${valueWei}`;
};

const primaryPaymentURI = toEip681(tipAmountEth);
const qrUrl = `https://quickchart.io/qr?text=${encodeURIComponent(primaryPaymentURI)}&size=240`;
---

<details class="tip-jar-disclosure toc-share-card">
  <summary class="toc-share-btn tip-jar-summary">抖內抖泥</summary>
  <section class="tip-jar" aria-label="打賞">
    <p class="tip-jar-line tip-ens-row">
      <span class="tip-ens-text">
        ENS：<code class="tip-ens-name">{ensName}</code>
      </span>
      {
        ens.isVerified ? (
          <span class="tip-verified-inline" aria-label="已驗證" title="已驗證">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5Zm-1.4 12.1-2.7-2.72 1.2-1.2 1.5 1.52 4.23-4.22 1.2 1.2-5.43 5.42Z"></path>
            </svg>
          </span>
        ) : (
          <span class="tip-status-inline">待驗證</span>
        )
      }
    </p>
    {
      ens.error && (
        <p class="tip-jar-line tip-warning">ENS 解析異常：{ens.error}</p>
      )
    }

    <div class="tip-actions">
      <button
        type="button"
        class="tip-pay-btn"
        data-tip-pay
        data-pay-uri={primaryPaymentURI}
        data-pay-copy={`收款地址：${tipAddress}\n建議金額：約 NT$${tipAmountNtd}（${tipAmountEth} ETH）\n鏈別 ID：${chainId}`}
      >抖內約 NT${tipAmountNtd} 的以太幣</button>
      <button
        type="button"
        class="tip-qr-btn"
        data-tip-qr-toggle
        aria-controls="tip-qr-panel"
        aria-expanded="false"
      >
        掃碼抖內
      </button>
      <p class="tip-pay-feedback" data-tip-pay-feedback hidden>已複製收款資訊，可貼到 Rabby 送出轉帳。</p>
    </div>

    <div class="tip-qr-panel" id="tip-qr-panel" hidden>
      <a class="tip-qr-link" href={primaryPaymentURI} aria-label="打開錢包付款請求">
        <img src={qrUrl} alt="打賞付款 QR code" width="180" height="180" loading="lazy" decoding="async" />
      </a>
    </div>
  </section>
</details>

<script is:inline>
  const tipRoot = document.currentScript?.previousElementSibling;
  const payButton = tipRoot?.querySelector("[data-tip-pay]");
  const payFeedback = tipRoot?.querySelector("[data-tip-pay-feedback]");
  const qrToggleBtn = tipRoot?.querySelector("[data-tip-qr-toggle]");
  const qrPanel = tipRoot?.querySelector("#tip-qr-panel");
  payButton?.addEventListener("click", async () => {
    if (!(payButton instanceof HTMLButtonElement)) return;
    const payUri = payButton.dataset.payUri ?? "";
    const payCopy = payButton.dataset.payCopy ?? "";
    if (payFeedback instanceof HTMLElement) payFeedback.hidden = true;
    if (payCopy) {
      try {
        await navigator.clipboard.writeText(payCopy);
        if (payFeedback instanceof HTMLElement) payFeedback.hidden = false;
      } catch {
        // ignore clipboard failures
      }
    }
    if (payUri) window.location.href = payUri;
  });
  qrToggleBtn?.addEventListener("click", () => {
    if (!(qrToggleBtn instanceof HTMLButtonElement) || !(qrPanel instanceof HTMLElement)) return;
    const isOpen = qrToggleBtn.getAttribute("aria-expanded") === "true";
    qrToggleBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
    qrToggleBtn.textContent = isOpen ? "掃碼抖內" : "收起掃碼";
    qrPanel.hidden = isOpen;
  });
</script>

<style>
  .tip-jar-disclosure {
    margin-top: 0;
  }

  .tip-jar-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    list-style: none;
  }

  .tip-jar-summary::-webkit-details-marker {
    display: none;
  }

  .tip-jar-disclosure[open] .tip-jar-summary {
    background: #ebf6f2;
    border-color: #a7cdc3;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .tip-jar {
    margin-top: 0;
    border: 1px solid #c8d9d3;
    border-top: 0;
    border-radius: 0.9rem;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    background: #f5fbf9;
    padding: 0.84rem;
  }

  .tip-jar-line {
    margin: 0;
    font-size: 0.88rem;
    color: #2b3f48;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.38rem;
  }

  .tip-ens-row {
    justify-content: flex-start;
    gap: 0.42rem;
  }

  .tip-ens-text {
    color: #1f3f4d;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .tip-ens-name {
    color: #173744;
    font-size: 0.8rem;
    line-height: 1;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .tip-verified-inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #0d6f61;
  }

  .tip-verified-inline svg {
    width: 0.98rem;
    height: 0.98rem;
    display: block;
    fill: currentColor;
  }

  .tip-status-inline {
    color: #7f5a1c;
    font-size: 0.76rem;
    line-height: 1.4;
  }

  .tip-actions {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.72rem;
  }

  .tip-pay-btn,
  .tip-qr-btn {
    border: 1px solid #c7d8d2;
    border-radius: 0.62rem;
    padding: 0.36rem 0.68rem;
    background: #ffffff;
    color: #2f5664;
    text-decoration: none;
    font-size: 0.82rem;
    cursor: pointer;
    text-align: center;
    min-height: 2.1rem;
  }

  .tip-pay-btn:hover,
  .tip-qr-btn:hover {
    color: #0b7d6d;
    border-color: #98d4c8;
    background: #eef8f4;
  }

  .tip-pay-feedback {
    margin: -0.08rem 0 0;
    color: #46616b;
    font-size: 0.76rem;
    line-height: 1.4;
    text-align: center;
  }

  .tip-qr-panel {
    margin-top: 0.72rem;
    text-align: center;
  }

  .tip-qr-link {
    display: inline-block;
    border: 1px solid #d1dfdb;
    border-radius: 0.8rem;
    padding: 0.45rem;
    background: #fff;
  }
</style>
