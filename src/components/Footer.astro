---
import {
  SITE_DESCRIPTION,
  SITE_DESCRIPTION_EN,
  SITE_TITLE,
  SITE_TITLE_EN,
  DEFAULT_LOCALE,
  type Locale
} from "@/site.config";
import { localizePath } from "@/utils/paths";
import { useTranslations } from "@/i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props as Props;
const t = useTranslations(lang);
const isEn = lang === "en";
const title = isEn ? SITE_TITLE_EN : SITE_TITLE;
const description = isEn ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION;
const ccHref = isEn
  ? "https://creativecommons.org/licenses/by-nc/4.0/"
  : "https://creativecommons.org/licenses/by-nc/4.0/deed.zh-hant";
const ccLabel = isEn
  ? "CC BY-NC 4.0 (Attribution-NonCommercial)"
  : "CC BY-NC 4.0（姓名標示-非商業性）";

const year = new Date().getFullYear();
const links = [{ href: localizePath("subscribe/", lang), label: t.footer.subscribe }];
---

<footer class="site-footer">
  <div class="container">
    <p>
      <strong>{title}</strong> · {description}
    </p>
    <div class="footer-meta-row">
      <p class="footer-links">
        {links.map((item) => <a href={item.href}>{item.label}</a>)}
      </p>
      <p class="footer-license">
        {isEn ? "All articles on this site are licensed under " : "本站文章皆採"}
        {" "}
        <a href={ccHref} target="_blank" rel="noopener noreferrer">
          {ccLabel}
        </a>
        {" "}
        {isEn ? "." : "授權。"}
      </p>
    </div>
    <p>© {year} mashbean. Some rights reserved.</p>
  </div>
</footer>
